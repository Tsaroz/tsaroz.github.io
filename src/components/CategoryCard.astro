---
import type { Category } from "@data";
import { categoryStats } from "@data";
import { Icon } from "astro-icon/components";
import { url } from "@utils/url";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const stats = categoryStats(category.slug);
const href = `/category/${category.slug}/`;
---

<a
  href={url(href)}
  class="nr-card group flex h-full flex-col gap-3 p-5 transition-shadow hover:shadow-card-hover"
>
  <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-100 transition-colors group-hover:bg-brand-600 group-hover:text-white">
    <Icon name={category.icon} class="size-5.5" aria-hidden="true" />
  </span>
  <span class="block font-display text-lg font-bold text-ink-900 group-hover:text-brand-700">{category.name}</span>
  <span class="line-clamp-2 text-sm leading-6 text-ink-600">{category.description}</span>
  <span class="mt-auto flex items-center gap-3 text-xs font-medium text-ink-600">
    <span>{stats.rankings} rankings</span>
    <span class="text-ink-300" aria-hidden="true">·</span>
    <span>{stats.entries} entries</span>
    <Icon name="lucide:arrow-right" class="ml-auto size-4 text-brand-600 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
  </span>
</a>
