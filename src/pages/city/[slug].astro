---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import SectionHeading from "@components/SectionHeading.astro";
import RankingCard from "@components/RankingCard.astro";
import AdSlot from "@components/AdSlot.astro";
import { getCities, getCityBySlug, getRankingsForCity } from "@data";
import type { City } from "@data";
import { url } from "@utils/url";

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const rankings = getRankingsForCity(city.slug);
const others = getCities().filter((c) => c.slug !== city.slug).slice(0, 8);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Community rankings in ${city.name}`,
  description: city.description,
  about: { "@type": "City", name: city.name },
};
---

<BaseLayout
  title={`Best in ${city.name}, City Rankings | NepalRanks`}
  description={`Everything the community ranks in ${city.name}: ${rankings.map((r) => r.title).join(", ") || "new rankings are on the way"}. Voted by the people who live there.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <AdSlot name="city_top" />

  <Breadcrumbs items={[{ name: "Cities", href: "/cities/" }, { name: city.name }]} />

  <header class="nr-container pb-4">
    <p class="nr-label flex items-center gap-2">
      <Icon name="lucide:building-2" class="size-4 text-brand-600" aria-hidden="true" />
      {city.name}{city.district ? ` · ${city.district}` : ""}
    </p>
    <h1 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">Best in {city.name}, voted by locals</h1>
    <p class="mt-2 max-w-3xl text-sm leading-7 text-ink-600 sm:text-base">{city.description}</p>
  </header>

  <section class="nr-container pt-4" aria-label={`Rankings in ${city.name}`}>
    {rankings.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {rankings.map((r) => <RankingCard ranking={r} />)}
      </div>
    ) : (
      <div class="nr-card flex flex-col items-center gap-4 bg-ink-50/80 px-6 py-12 text-center">
        <Icon name="lucide:hourglass" class="size-8 text-ink-400" aria-hidden="true" />
        <p class="font-display text-lg font-bold">No rankings in {city.name} yet.</p>
        <p class="max-w-md text-sm text-ink-600">
          The city page is live, the first ranking (like <em>Best momo in {city.name}</em>) opens with the
          next publish. <a href={url("/contact/")} class="nr-link">Tell us what {city.name} should rank.</a>
        </p>
      </div>
    )}
  </section>

  <section class="nr-container pt-12" aria-label="Other cities">
    <SectionHeading title="Other cities" icon="lucide:map" allHref="/cities/" allLabel="All cities" />
    <ul class="flex flex-wrap gap-2">
      {others.map((c: City) => (
        <li><a href={url(`/city/${c.slug}/`)} class="nr-badge bg-ink-100 text-ink-700 hover:bg-brand-50 hover:text-brand-700">{c.name}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
