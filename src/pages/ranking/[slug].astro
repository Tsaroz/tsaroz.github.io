---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import NoticeBar from "@components/NoticeBar.astro";
import RankItem from "@components/RankItem.astro";
import VoteAllowance from "@components/VoteAllowance.astro";
import LiveEngage from "@components/LiveEngage.astro";
import AdSlot from "@components/AdSlot.astro";
import { Icon } from "astro-icon/components";
import {
  getRankings,
  getRankingBySlug,
  getRankedEntries,
  decorate,
} from "@data";
import { url, formatNumber, timeAgo } from "@utils/url";
import { IS_LIVE } from "@lib/config";

export function getStaticPaths() {
  return getRankings().map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const ranking = getRankingBySlug(slug!);
if (!ranking) return Astro.redirect("/404/");

const entries = getRankedEntries(ranking.id);
const d = decorate(ranking);
const site = Astro.site ?? new URL("https://nepalranks.com");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: ranking.title,
    description: IS_LIVE ? "Community-voted ranking on NepalRanks, updated live." : "Community-voted ranking on NepalRanks (design preview with sample data).",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: entries.length,
    itemListElement: entries.map((e) => ({
      "@type": "ListItem",
      position: e.rank,
      name: e.name,
      url: String(new URL(`ranking/${ranking.slug}/${e.slug}/`, site)),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Categories", item: String(new URL("categories/", site)) },
      { "@type": "ListItem", position: 2, name: d.category?.name ?? "", item: String(new URL(`category/${d.category?.slug}/`, site)) },
      { "@type": "ListItem", position: 3, name: ranking.title, item: String(new URL(`ranking/${ranking.slug}/`, site)) },
    ],
  },
];

const crumbCategory = d.category
  ? { name: d.category.name, href: `/category/${d.category.slug}/` }
  : undefined;
---

<BaseLayout
  title={`${ranking.title}, Community Vote | NepalRanks`}
  description={`${ranking.description} Current #1: ${entries[0]?.name}. ${formatNumber(d.totalVotes)} votes across ${entries.length} entries.${IS_LIVE ? " Community-voted, updated live." : " Design preview, fictional data."}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  {ranking.ad?.trim() ? (
    <div class="nr-container pt-6">
      <div class="mx-auto max-w-4xl overflow-hidden text-center">
        <p class="nr-label mb-1 text-ink-600">Sponsored</p>
        <div class="nr-card p-3" set:html={ranking.ad} />
      </div>
    </div>
  ) : (
    <AdSlot name="ranking_top" />
  )}

  <Breadcrumbs
    items={crumbCategory
      ? [
          { name: "Categories", href: "/categories/" },
          crumbCategory,
          { name: ranking.title },
        ]
      : [{ name: "Categories", href: "/categories/" }, { name: ranking.title }]}
  />

  <header class="nr-container pb-6">
    <div class="flex flex-wrap items-center gap-2">
      {d.category && (
        <a href={url(`/category/${d.category.slug}/`)} class="nr-badge bg-brand-50 text-brand-700 hover:bg-brand-100">
          <Icon name={d.category.icon} class="size-3.5" aria-hidden="true" />
          {d.category.name}
        </a>
      )}
      <span class="nr-badge bg-ink-100 text-ink-600">Community-voted</span>
    </div>
    <h1 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">{ranking.title}</h1>
    <p class="mt-2 max-w-3xl text-sm leading-7 text-ink-600 sm:text-base">{ranking.description}</p>
    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-600">
      <span class="inline-flex items-center gap-1.5"><Icon name="lucide:boxes" class="size-4 text-ink-600" aria-hidden="true" />{entries.length} entries</span>
      <span class="inline-flex items-center gap-1.5"><Icon name="lucide:vote" class="size-4 text-ink-600" aria-hidden="true" /><span data-live-total-votes={d.totalVotes}>{formatNumber(d.totalVotes)}</span> votes</span>
      <span class="inline-flex items-center gap-1.5"><Icon name="lucide:messages-square" class="size-4 text-ink-600" aria-hidden="true" />{d.commentCount} comments</span>
      <span class="inline-flex items-center gap-1.5"><Icon name="lucide:clock" class="size-4 text-ink-600" aria-hidden="true" />updated {timeAgo(decorate(ranking).lastActivity)}</span>
    </p>
  </header>

  <NoticeBar scope="ranking" />

  <section class="nr-container pt-6" aria-label="Voting allowance">
    <VoteAllowance categoryId={ranking.categoryId} />
  </section>

  <ol class="nr-container space-y-4 pt-6" data-rank-list aria-label={`Ranked entries, ${ranking.title}`}>
    {entries.map((e, i) => (
      <>
        <RankItem entry={e} ranking={ranking} />
        {i === 4 && (
          <li class="list-none">
            <AdSlot name="ranking_inline" bare class="my-1" />
          </li>
        )}
      </>
    ))}
  </ol>

  <LiveEngage />
</BaseLayout>
