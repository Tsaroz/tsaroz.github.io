---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { url } from "@utils/url";
---

<BaseLayout
  title="Page not found | NepalRanks"
  description="The page you requested does not exist on NepalRanks."
  noindex
>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <span
      class="grid size-16 place-items-center rounded-2xl border-2"
      style="border-color: var(--nr-border); background: var(--nr-gold); color: var(--nr-ink-900); box-shadow: var(--shadow-pop-sm);"
    >
      <Icon name="lucide:compass" class="size-8" aria-hidden="true" />
    </span>
    <p class="mt-6 font-display text-7xl font-bold" style="color: var(--nr-crimson);">404</p>
    <h1 class="mt-2 font-display text-2xl font-bold">This page has wandered off</h1>
    <p class="mt-3 max-w-md text-sm leading-6" style="color: var(--nr-text-muted);">
      The page you were looking for doesn't exist or has moved. Try our guides instead.
    </p>
    <p class="mt-7 flex flex-wrap justify-center gap-3">
      <a href={url("/")} class="nr-btn nr-btn-primary">
        <Icon name="lucide:house" class="size-4" aria-hidden="true" /> Home
      </a>
      <a href={url("/articles/")} class="nr-btn nr-btn-outline">
        <Icon name="lucide:newspaper" class="size-4" aria-hidden="true" /> All articles
      </a>
    </p>
  </div>
</BaseLayout>
