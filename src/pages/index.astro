---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArticleCard from "@components/ArticleCard.astro";
import { Icon } from "astro-icon/components";
import { getArticles } from "@lib/articles";
import { url } from "@utils/url";

const articles = await getArticles();
const featured = articles.filter((a) => a.data.featured);
const lead = featured[0] ?? articles[0];
const rest = articles.filter((a) => a !== lead);
const comparisons = articles.filter((a) => a.data.articleType !== "info" && a.data.products.length > 0).length;
const guides = articles.length - comparisons;
const site = Astro.site ?? new URL("https://nepalranks.com");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "NepalRanks",
  url: site.href,
  description: "Independent rankings and guides for the best products, restaurants, places and experiences in Nepal.",
  inLanguage: "en",
};
---

<BaseLayout
  title="NepalRanks — Expert Rankings & Guides for Nepal"
  description="Honest, research-backed rankings and guides for the best products, restaurants, tourist places and experiences in Nepal."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Intro -->
  <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 sm:pt-14">
    <div class="flex flex-col gap-6 border-b-2 pb-8 sm:flex-row sm:items-end sm:justify-between" style="border-color: var(--nr-border);">
      <div class="max-w-2xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="nr-badge" style="background: var(--nr-crimson); color: #fff;">
            <Icon name="lucide:sparkles" class="size-3" aria-hidden="true" /> Independent · Research-backed
          </span>
          <span class="nr-badge" style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);">
            Est. 2026
          </span>
        </div>
        <h1 class="mt-4 font-display text-3xl font-bold leading-[1.08] tracking-tight sm:text-4xl lg:text-5xl">
          The best of
          <span class="relative inline-block">
            <span class="relative z-10">Nepal.</span>
            <span class="absolute inset-x-0 bottom-1 z-0 h-2.5 sm:h-3" style="background: var(--nr-gold);"></span>
          </span>
        </h1>
        <p class="mt-4 text-lg leading-8" style="color: var(--nr-text-muted);">
          Honest rankings and guides for the products, restaurants, tourist places and experiences
          that matter in Nepal — researched, compared and written by people who live here.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 sm:flex-col sm:items-stretch">
        <a href={url("/articles/")} class="nr-btn nr-btn-primary">
          Browse all articles <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
        <a href={url("/about/")} class="nr-btn nr-btn-outline">How we rank</a>
      </div>
    </div>

    <dl class="mt-6 flex flex-wrap gap-3">
      <div class="nr-panel px-4 py-2.5">
        <dt class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">Rankings</dt>
        <dd class="font-display text-xl font-bold">{comparisons}</dd>
      </div>
      <div class="nr-panel px-4 py-2.5">
        <dt class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">Explainers</dt>
        <dd class="font-display text-xl font-bold">{guides}</dd>
      </div>
      <div class="nr-panel px-4 py-2.5">
        <dt class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">Picks ranked</dt>
        <dd class="font-display text-xl font-bold">
          {articles.reduce((n, a) => n + a.data.products.length, 0)}
        </dd>
      </div>
    </dl>
  </section>

  {lead && (
    <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <p class="nr-label">Editor's pick</p>
          <h2 class="mt-1 font-display text-2xl font-bold sm:text-3xl">Start here</h2>
        </div>
      </div>
      <ArticleCard article={lead} featured />
    </section>
  )}

  {rest.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6" aria-labelledby="latest-h">
      <div class="mb-6 flex items-end justify-between gap-4 border-b-2 pb-3" style="border-color: var(--nr-border);">
        <h2 id="latest-h" class="font-display text-2xl font-bold sm:text-3xl">Latest rankings & guides</h2>
        <a href={url("/articles/")} class="inline-flex items-center gap-1 text-sm font-bold hover:underline" style="color: var(--nr-accent);">
          All articles <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  {articles.length === 0 && (
    <section class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6">
      <p style="color: var(--nr-text-muted);">No articles yet. Add one from the admin panel.</p>
    </section>
  )}
</BaseLayout>
