---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  brand?: string;
  price?: string;
  badge?: string;
  image?: string;
  imageAlt?: string;
  summary?: string;
  specs?: Record<string, string>;
  pros?: string[];
  cons?: string[];
  verdict?: string;
  link?: string;
  rank?: number;
  anchor?: string;
}

const {
  name,
  brand,
  price,
  badge,
  image,
  imageAlt,
  summary,
  specs,
  pros = [],
  cons = [],
  verdict,
  link,
  rank,
  anchor,
} = Astro.props;
const specEntries = Object.entries(specs ?? {}).slice(0, 6);
const hasLists = pros.length > 0 || cons.length > 0;
---

<section id={anchor} class="scroll-mt-24">
  <article class="nr-card overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 px-5 py-3" style="border-color: var(--nr-border); background: var(--nr-bg-sunken);">
      <div class="flex items-center gap-2.5">
        {rank && (
          <span
            class="grid size-8 place-items-center rounded-lg border-2 font-display text-sm font-bold"
            style="border-color: var(--nr-border); background: var(--nr-accent); color: var(--nr-accent-ink);"
          >
            {rank}
          </span>
        )}
        {badge && (
          <span class="nr-badge" style="background: var(--nr-gold); color: var(--nr-ink-900);">
            <Icon name="lucide:star" class="size-3" aria-hidden="true" />{badge}
          </span>
        )}
      </div>
      {price && (
        <span class="font-display text-lg font-bold" style="color: var(--nr-accent);">{price}</span>
      )}
    </div>

    <div class="grid gap-0 sm:grid-cols-[minmax(0,16rem)_1fr]">
      <div
        class="nr-halftone relative flex items-center justify-center border-b-2 p-6 sm:border-b-0 sm:border-r-2"
        style="background: var(--nr-bg-sunken); border-color: var(--nr-border);"
      >
        {image ? (
          <img
            src={image}
            alt={imageAlt ?? name}
            loading="lazy"
            class="h-44 w-full rounded-lg object-contain"
          />
        ) : (
          <div class="grid h-44 w-full place-items-center rounded-lg border-2 border-dashed" style="border-color: var(--nr-border-soft); color: var(--nr-text-soft);">
            <Icon name="lucide:image" class="size-10" aria-hidden="true" />
          </div>
        )}
      </div>

      <div class="p-5 sm:p-6">
        <h3 class="font-display text-xl font-bold leading-tight">{name}</h3>
        {brand && (
          <p class="mt-1 font-mono text-[11px] font-bold uppercase tracking-[0.14em]" style="color: var(--nr-text-soft);">
            {brand}
          </p>
        )}
        {summary && (
          <p class="mt-3 text-sm leading-6" style="color: var(--nr-text-muted);">{summary}</p>
        )}

        {hasLists && (
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            {pros.length > 0 && (
              <div class="rounded-lg border-2 p-3" style="border-color: var(--nr-pros-border); background: var(--nr-pros-bg);">
                <p class="mb-2 flex items-center gap-1.5 font-mono text-[10px] font-bold uppercase tracking-[0.14em]" style="color: var(--nr-pros-head);">
                  <Icon name="lucide:plus-circle" class="size-3.5" aria-hidden="true" /> Pros
                </p>
                <ul class="space-y-1.5">
                  {pros.map((pro) => (
                    <li class="flex gap-1.5 text-[13px] leading-5" style="color: var(--nr-pros-ink);">
                      <Icon name="lucide:check" class="mt-0.5 size-3.5 shrink-0" style="color: var(--nr-pros-border);" aria-hidden="true" />
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {cons.length > 0 && (
              <div class="rounded-lg border-2 p-3" style="border-color: var(--nr-cons-border); background: var(--nr-cons-bg);">
                <p class="mb-2 flex items-center gap-1.5 font-mono text-[10px] font-bold uppercase tracking-[0.14em]" style="color: var(--nr-cons-head);">
                  <Icon name="lucide:minus-circle" class="size-3.5" aria-hidden="true" /> Cons
                </p>
                <ul class="space-y-1.5">
                  {cons.map((con) => (
                    <li class="flex gap-1.5 text-[13px] leading-5" style="color: var(--nr-cons-ink);">
                      <Icon name="lucide:x" class="mt-0.5 size-3.5 shrink-0" style="color: var(--nr-cons-border);" aria-hidden="true" />
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        {specEntries.length > 0 && (
          <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t-2 pt-4 sm:grid-cols-3" style="border-color: var(--nr-border-soft);">
            {specEntries.map(([k, v]) => (
              <div class="flex flex-col">
                <dt class="font-mono text-[9px] font-bold uppercase tracking-[0.12em]" style="color: var(--nr-text-soft);">{k}</dt>
                <dd class="text-sm font-semibold" style="color: var(--nr-text);">{v}</dd>
              </div>
            ))}
          </dl>
        )}

        {verdict && (
          <div class="mt-5 flex items-start gap-2 rounded-lg border-l-4 p-3" style="background: var(--nr-bg-sunken);">
            <Icon name="lucide:badge-check" class="mt-0.5 size-4 shrink-0" style="color: var(--nr-accent);" aria-hidden="true" />
            <p class="text-[13px] leading-5" style="color: var(--nr-text-muted);">{verdict}</p>
          </div>
        )}

        {link && (
          <a href={link} class="nr-btn nr-btn-primary mt-5 w-full sm:w-auto">
            Check price <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
          </a>
        )}
      </div>
    </div>
  </article>
</section>
