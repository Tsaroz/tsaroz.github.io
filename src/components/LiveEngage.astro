<div id="vote-toast" role="status" aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-4">
  <p class="hidden rounded-xl border border-ink-200 bg-ink-900 px-4 py-2.5 text-sm font-medium text-white shadow-card">
    <span data-toast-text></span>
  </p>
</div>

<script>
  import { initVotes, initComments } from "@lib/live";

  const toastWrap = document.querySelector<HTMLElement>("#vote-toast p")!;
  const toastText = toastWrap.querySelector<HTMLElement>("[data-toast-text]")!;
  let toastTimer: number | undefined;
  function toast(msg: string) {
    toastText.textContent = msg;
    toastWrap.classList.remove("hidden");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastWrap.classList.add("hidden"), 2800);
  }

  initVotes(toast);
  initComments(toast);
</script>
