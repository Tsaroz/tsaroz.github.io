---

import { Icon } from "astro-icon/components";
import { url } from "@utils/url";
import { CP, PANEL_URL } from "@lib/config";
---

<a
  href={(PANEL_URL || url(CP + "/"))}
  data-nav-staff
  href-set="panel"
  class="hidden shrink-0 rounded-lg border border-brand-200 bg-brand-50 px-3 py-1.5 text-sm font-semibold text-brand-700 hover:bg-brand-100"
  >Admin</a
>
<div id="nr-auth" class="relative shrink-0">
  <button
    type="button"
    data-auth-state="loading"
    class="inline-flex items-center gap-2 rounded-lg border border-ink-200 bg-ink-50 px-3 py-1.5 text-sm font-medium text-ink-600 hover:border-brand-400 hover:text-brand-700"
  >
    <span data-auth-icon class="grid size-5 place-items-center rounded-full bg-ink-200 text-[10px] font-bold text-ink-600">?</span>
    <span data-auth-label class="hidden max-w-32 truncate sm:inline">Sign in</span>
  </button>
  <div
    data-auth-menu
    class="absolute right-0 z-40 mt-1 hidden w-56 rounded-xl border border-ink-200 bg-white p-1.5 text-sm shadow-card-hover"
  >
    <p class="px-3 py-2 text-xs text-ink-600">Signed in as <span data-auth-name class="font-semibold text-ink-800"></span></p>
    <a data-auth-admin href={PANEL_URL || url(CP + "/")} class="hidden w-full rounded-lg px-3 py-2 text-left font-medium text-brand-700 hover:bg-brand-50">Admin panel →</a>
    <button type="button" data-auth-signout class="w-full rounded-lg px-3 py-2 text-left font-medium text-ink-700 hover:bg-ink-100">
      Sign out
    </button>
  </div>
</div>

<script>
  import { sb, session, displayName, requireAuth, signOut, userRole } from "@lib/auth";

  const wrap = document.getElementById("nr-auth")!;
  const btn = wrap.querySelector<HTMLButtonElement>("[data-auth-state]")!;
  const icon = wrap.querySelector<HTMLElement>("[data-auth-icon]")!;
  const label = wrap.querySelector<HTMLElement>("[data-auth-label]")!;
  const menu = wrap.querySelector<HTMLElement>("[data-auth-menu]")!;

  async function render() {
    const s = await session();
    if (!sb()) {
      btn.title = "Live backend not configured";
      return;
    }
    if (s) {
      const name = displayName(s);
      const role = await userRole();
      const adminLink = wrap.querySelector<HTMLElement>("[data-auth-admin]");
      if (adminLink) adminLink.classList.toggle("hidden", role === "");
      const nav = document.querySelector<HTMLElement>("[data-nav-staff]");
      if (nav) {
        nav.classList.toggle("hidden", role === "");
        nav.textContent = role === "moderator" ? "Moderation" : "Admin";
      }
      icon.textContent = name.slice(0, 1).toUpperCase();
      icon.className = icon.className.replace(/bg-ink-200 text-\[10px\] font-bold text-ink-600/, "bg-brand-600 text-white");
      label.textContent = name;
      wrap.querySelector("[data-auth-name]")!.textContent = name;
    } else {
      icon.innerHTML = '<svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 6.96 23 12 23z"/><path fill="#FBBC05" d="M6.84 14.1A6.88 6.88 0 0 1 6.48 12c0-.73.13-1.44.36-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/></svg>';
      icon.className = icon.className.replace(/bg-brand-600 text-white/, "bg-ink-200 text-[10px] font-bold text-ink-600");
      label.textContent = "Sign in";
    }
  }

  btn.addEventListener("click", async (e) => {
    e.stopPropagation();
    const s = await session();
    if (s) {
      menu.classList.toggle("hidden");
    } else {
      await requireAuth();
    }
  });
  wrap.querySelector("[data-auth-signout]")!.addEventListener("click", () => void signOut());
  document.addEventListener("click", (e) => {
    if (!wrap.contains(e.target as Node)) menu.classList.add("hidden");
  });
  window.addEventListener("nr:require-signin", () => void requireAuth());
  sb()?.auth.onAuthStateChange(() => void render());
  void render();
</script>
