---

import { Icon } from "astro-icon/components";
import { url } from "@utils/url";

interface Props {
  variant?: "nav" | "page";
  autofocus?: boolean;
  id?: string;
}

const { variant = "nav", autofocus = false, id = "nr-suggest" } = Astro.props;
const inputClass =
  variant === "nav"
    ? "w-full rounded-lg border border-ink-200 bg-ink-50 py-1.5 pl-8 pr-3 text-sm placeholder:text-ink-400 focus:border-brand-400 lg:w-56"
    : "w-full rounded-xl border border-ink-200 bg-white py-3 pl-11 pr-4 text-sm shadow-card placeholder:text-ink-400 focus:border-brand-400";
const iconClass = variant === "nav" ? "left-2.5 size-4" : "left-3.5 size-5";
---

<div class:list={["relative", variant === "nav" ? "hidden sm:block" : "max-w-xl"]} data-suggest data-variant={variant}>
  <Icon name="lucide:search" class:list={["pointer-events-none absolute top-1/2 -translate-y-1/2 text-ink-400", iconClass]} aria-hidden="true" />
  <label for={id} class="sr-only">Search rankings and entries</label>
  <input
    id={id}
    type="search"
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-controls={`${id}-list`}
    placeholder={variant === "nav" ? "Search…" : "Try “bank”, “momo”, “Pokhara”…"}
    class={inputClass}
    autofocus={autofocus}
  />
  <div id={`${id}-list`} data-suggest-list class="nr-suggest-list hidden" role="listbox"></div>
</div>

<script>
  import { mountSuggest, type SuggestItem } from "@lib/suggest";

  document.querySelectorAll<HTMLElement>("[data-suggest]").forEach((wrap) => {
    const input = wrap.querySelector("input")!;
    const list = wrap.querySelector<HTMLElement>("[data-suggest-list]")!;
    const page = wrap.dataset.variant === "page";
    mountSuggest({
      input,
      list,
      wrap,
      onNavigate: (it: SuggestItem) => {
        location.href = it.u;
      },
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !page && !list.querySelector("[data-active]")) {
        const q = input.value.trim();
        if (q) location.href = new URL(`search/?q=${encodeURIComponent(q)}`, document.baseURI).href;
      }
    });
  });
</script>
