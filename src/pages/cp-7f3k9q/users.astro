---
import AdminLayout from "@layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
---

<AdminLayout title="Users" heading="Users & staff" sub="Everyone votes and comments with a Google account. Roles are granted here; bans from the Comments tab.">
  <section class="nr-card mb-6 p-5">
    <h2 class="flex items-center gap-2 font-display text-base font-bold">
      <Icon name="lucide:key-round" class="size-4.5 text-brand-600" aria-hidden="true" />
      Access requests
      <span data-req-count class="nr-badge bg-ink-100 tabular-nums text-ink-600">…</span>
    </h2>
    <div id="req-self" class="mt-3 hidden">
      <p class="text-sm text-ink-600">You are signed in without a staff role.</p>
      <button type="button" data-request class="nr-btn-primary mt-3">Request staff access</button>
      <p data-request-state class="mt-2 text-xs text-ink-500"></p>
    </div>
    <ul class="mt-3 space-y-2" data-req-list></ul>
    <p data-req-empty class="mt-3 text-xs text-ink-500">No pending requests.</p>
  </section>

  <section class="nr-card mb-6 p-5">
    <h2 class="flex items-center gap-2 font-display text-base font-bold">
      <Icon name="lucide:shield-check" class="size-4.5 text-up-600" aria-hidden="true" />
      Current staff
    </h2>
    <ul class="mt-3 divide-y divide-ink-100 text-sm" data-staff-list></ul>
  </section>

  <section class="nr-card p-5">
    <h2 class="flex items-center gap-2 font-display text-base font-bold">
      <Icon name="lucide:messages-square" class="size-4.5 text-brand-600" aria-hidden="true" />
      Accounts in public record
    </h2>
    <p class="mt-1 text-xs text-ink-500">Commenters (newest first). Ban from the Comments tab; raw voter identities stay in the Supabase dashboard.</p>
    <table class="nr-cards mt-3 w-full text-left text-sm">
      <thead>
        <tr class="border-b border-ink-100 text-xs uppercase tracking-wide text-ink-500">
          <th class="py-2 pr-3 font-semibold">Account</th>
          <th class="py-2 pr-3 font-semibold">Nicknames used</th>
          <th class="py-2 text-right font-semibold">Comments</th>
        </tr>
      </thead>
      <tbody data-body class="divide-y divide-ink-100"></tbody>
    </table>
  </section>

  <script>
    import { list, rpc, userRole, adminGuard } from "@lib/adminclient";
    import { session } from "@lib/auth";
    import { adminToast } from "@lib/admin";

    const esc = (s: string) => s.replace(/[&><"']/g, (ch) => ({ "&": "&amp;", ">": "&gt;", "<": "&lt;", '"': "&quot;", "'": "&#39;" })[ch]!);
    type Req = { user_id: string; email: string | null; nickname: string | null; requested: string };
    type Staff = { user_id: string; email: string | null; role: string };

    if (!adminGuard()) throw new Error("guard");
    const role = await userRole();
    const staff = role === "admin" || role === "moderator";

    if (!staff) document.getElementById("req-self")!.classList.remove("hidden");
    document.querySelector<HTMLButtonElement>("[data-request]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const state = document.querySelector("[data-request-state]")!;
      btn.disabled = true;
      try {
        const res = await rpc<{ ok: boolean; error?: string }>("request_access", {});
        state.textContent = res.ok ? "Request sent; an admin will see it here." : res.error ?? "Failed.";
        if (!res.ok) btn.disabled = false;
      } catch (err) {
        state.textContent = String(err);
        btn.disabled = false;
      }
    });

    async function loadRequests() {
      const listEl = document.querySelector<HTMLElement>("[data-req-list]")!;
      const empty = document.querySelector<HTMLElement>("[data-req-empty]")!;
      try {
        const reqs = (staff ? await rpc<Req[]>("pending_requests", {}) : []) as Req[];
        document.querySelector("[data-req-count]")!.textContent = String(reqs.length);
        empty.classList.toggle("hidden", reqs.length > 0 || !staff);
        listEl.innerHTML = reqs
          .map(
            (r) =>
              `<li class="flex flex-wrap items-center gap-2 rounded-lg bg-ink-50 px-3 py-2.5"><span class="min-w-0 flex-1"><span class="block font-semibold text-ink-900">${esc(r.nickname ?? "?")}</span>` +
              `<span class="block text-xs text-ink-500">${esc(r.email ?? r.user_id.slice(0, 8))}</span></span>` +
              (role === "admin"
                ? `<span class="flex gap-1.5">` +
                  `<button type="button" data-grant="${r.user_id}" data-role="moderator" class="rounded-md bg-brand-600 px-2.5 py-1.5 text-xs font-semibold text-white">Make moderator</button>` +
                  `<button type="button" data-grant="${r.user_id}" data-role="admin" class="rounded-md border border-brand-300 px-2.5 py-1.5 text-xs font-semibold text-brand-700">Make admin</button>` +
                  `<button type="button" data-grant="${r.user_id}" data-role="dismiss" class="rounded-md border border-ink-200 px-2.5 py-1.5 text-xs font-semibold text-ink-500 hover:border-down-500 hover:text-down-700">Dismiss</button></span>`
                : `<span class="nr-badge bg-gold-100 text-gold-700">awaiting an admin</span>`) +
              `</li>`,
          )
          .join("");
      } catch (err) {
        adminToast(`Requests: ${String(err)}`, false);
      }
    }

    document.querySelector("[data-req-list]")!.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-grant]");
      if (!btn) return;
      try {
        await rpc("resolve_request", { p_user: btn.dataset.grant, p_action: btn.dataset.role });
        adminToast(btn.dataset.role === "dismiss" ? "Dismissed." : `Approved as ${btn.dataset.role}.`);
        loadRequests();
        loadStaff();
      } catch (err) { adminToast(String(err), false); }
    });

    async function loadStaff() {
      const el = document.querySelector<HTMLElement>("[data-staff-list]")!;
      try {
        const dir = (await rpc<Staff[]>("staff_directory", {})) as Staff[];
        el.innerHTML = dir?.length
          ? dir
              .map((u) => `<li class="flex items-center justify-between gap-3 py-2"><span class="min-w-0 truncate">${esc(u.email ?? u.user_id.slice(0, 8))}</span><span class="nr-badge ${u.role === "admin" ? "bg-brand-50 text-brand-700" : "bg-up-100 text-up-700"}">${u.role}</span></li>`)
              .join("")
          : `<li class="py-2 text-xs text-ink-500">None beyond you.</li>`;
      } catch {
        el.innerHTML = `<li class="py-2 text-xs text-ink-500">Staff access requests are unavailable in this deployment.</li>`;
      }
    }

    async function loadCommenters() {
      const body = document.querySelector<HTMLElement>("[data-body]")!;
      try {
        type Cmt = { user_id: string | null; email: string | null; author: string };
        const rows = await list<Cmt>("moderation_queue", "?select=user_id,email,author&user_id=not.is.null&order=created_at.desc&limit=500");
        const map = new Map<string, { email?: string; names: Set<string>; n: number }>();
        for (const r of rows) {
          if (!r.user_id) continue;
          const cur = map.get(r.user_id) ?? { email: r.email ?? undefined, names: new Set<string>(), n: 0 };
          cur.names.add(r.author); cur.n++;
          map.set(r.user_id, cur);
        }
        body.innerHTML = [...map.entries()]
          .slice(0, 60)
          .map(([id, u]) => `<tr><td class="py-2 pr-3" data-label="Account">${esc(u.email ?? id.slice(0, 8))}</td><td class="py-2 pr-3 text-ink-600" data-label="Nicknames">${esc([...u.names].join(", "))}</td><td class="py-2 text-right tabular-nums" data-label="Comments">${u.n}</td></tr>`)
          .join("") || `<tr><td colspan="3" class="py-4 text-center text-ink-500">No accounts yet.</td></tr>`;
      } catch (err) { adminToast(`Users: ${String(err)}`, false); }
    }

    await Promise.all([loadRequests(), loadStaff(), loadCommenters()]);
    void session();
  </script>
</AdminLayout>
