---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductCard from "@components/ProductCard.astro";
import ComparisonTable from "@components/ComparisonTable.astro";
import Toc from "@components/Toc.astro";
import { url } from "@utils/url";
import { formatDate, readingTime, slugOf, type Article } from "@lib/articles";
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
  buildItemListJsonLd,
  buildFaqJsonLd,
  analyzeSeo,
  type SiteContext,
} from "@lib/seo";

interface Props {
  entry: Article;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const d = entry.data;
const body = entry.body ?? "";
const site = Astro.site ?? new URL("https://nepalranks.com");

const seoInput = {
  ...d,
  slug: slugOf(entry),
  body,
};
const ctx: SiteContext = {
  origin: site.origin,
  siteName: "NepalRanks",
  logo: "favicon.svg",
};

const articleLd = buildArticleJsonLd(seoInput, ctx);
const breadcrumbLd = buildBreadcrumbJsonLd(seoInput, ctx);
const itemListLd = buildItemListJsonLd(seoInput);
const faqLd = buildFaqJsonLd(d.faqs ?? []);
const seo = import.meta.env.DEV ? analyzeSeo(seoInput) : null;
---

<BaseLayout
  title={`${d.title} | NepalRanks`}
  description={d.description}
  ogImage={d.coverImage}
  ogType="article"
  noindex={d.noindex}
  publishedTime={d.publishedAt.toISOString()}
  modifiedTime={(d.updatedAt ?? d.publishedAt).toISOString()}
  articleAuthor={d.author}
  articleSection={d.category}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />
  {itemListLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListLd)} />}
  {faqLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />}
  {d.keywords.length > 0 && <meta name="keywords" content={d.keywords.join(", ")} slot="head" />}
  <meta name="robots" content={d.noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} slot="head" />

  <!-- Breadcrumbs -->
  <div class="nr-container pt-6">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={url("/")} class="hover:text-brand-700">Home</a></li>
        <li aria-hidden="true"><Icon name="lucide:chevron-right" class="size-3.5" /></li>
        <li><a href={url("/articles/")} class="hover:text-brand-700">Articles</a></li>
        <li aria-hidden="true"><Icon name="lucide:chevron-right" class="size-3.5" /></li>
        <li class="truncate text-ink-700" aria-current="page">{d.title}</li>
      </ol>
    </nav>
  </div>

  <!-- Article header -->
  <header class="nr-prose pt-6">
    <span class="nr-badge bg-brand-50 text-brand-700">{d.category}</span>
    <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-ink-900 sm:text-4xl">
      {d.title}
    </h1>
    <p class="mt-4 text-lg leading-8 text-ink-600">{d.description}</p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-500">
      <span class="inline-flex items-center gap-1.5"><Icon name="lucide:user" class="size-4" />{d.author}</span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:calendar" class="size-4" />
        <time datetime={d.publishedAt.toISOString()}>{formatDate(d.updatedAt ?? d.publishedAt)}</time>
      </span>
      <span class="inline-flex items-center gap-1.5"><Icon name="lucide:clock" class="size-4" />{readingTime(body)} min read</span>
    </div>
  </header>

  {d.coverImage && (
    <div class="nr-container mt-8">
      <img
        src={d.coverImage}
        alt={d.coverImageAlt ?? d.title}
        class="aspect-[16/9] w-full rounded-2xl border border-ink-200 object-cover shadow-card"
        fetchpriority="high"
      />
    </div>
  )}

  <!-- Body + TOC -->
  <div class="nr-container mt-10 grid gap-10 lg:grid-cols-[1fr_minmax(0,15rem)]">
    <div class="min-w-0">
      {d.intro && (
        <div class="nr-article">
          <p class="text-lg leading-8 text-ink-700">{d.intro}</p>
        </div>
      )}

      {d.products.length > 0 && (
        <section class="mt-10" aria-labelledby="products-h">
          <h2 id="products-h" class="font-display text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl scroll-mt-24">
            Our picks at a glance
          </h2>
          <div class="mt-5 space-y-5">
            {d.products.map((p, i) => (
              <ProductCard {...p} rank={i + 1} anchor={`pick-${i + 1}`} />
            ))}
          </div>
        </section>
      )}

      {d.comparisonColumns.length > 0 && d.products.length > 0 && (
        <section class="mt-12" aria-labelledby="compare-h">
          <h2 id="compare-h" class="font-display text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl scroll-mt-24">
            Comparison table
          </h2>
          <ComparisonTable products={d.products} columns={d.comparisonColumns} />
        </section>
      )}

      <div class="nr-article mt-12">
        <slot />
      </div>

      {d.conclusion && (
        <section class="mt-12" aria-labelledby="conclusion-h">
          <h2 id="conclusion-h" class="font-display text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl scroll-mt-24">
            Conclusion
          </h2>
          <div class="mt-3 rounded-xl border-l-4 border-brand-500 bg-brand-50/70 p-5 text-[1.0625rem] leading-8 text-ink-800">
            <p>{d.conclusion}</p>
          </div>
        </section>
      )}

      {(d.faqs ?? []).length > 0 && (
        <section class="mt-12" aria-labelledby="faq-h">
          <h2 id="faq-h" class="font-display text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl scroll-mt-24">
            Frequently asked questions
          </h2>
          <div class="mt-4 divide-y divide-ink-200 rounded-xl border border-ink-200">
            {d.faqs.map((f) => (
              <details class="group px-5 py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold text-ink-900 [&::-webkit-details-marker]:hidden">
                  <span>{f.question}</span>
                  <Icon name="lucide:chevron-down" class="size-4 shrink-0 text-ink-500 transition-transform group-open:rotate-180" />
                </summary>
                <p class="mt-2 text-sm leading-7 text-ink-600">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <Toc headings={headings} />
      </div>
    </aside>
  </div>

  {seo && (
    <div class="nr-container mt-12">
      <details class="rounded-xl border border-dashed border-gold-500/50 bg-gold-100/40 p-4 text-sm">
        <summary class="cursor-pointer font-semibold text-ink-800">
          SEO self-check (dev only) — score {seo.score}/100
        </summary>
        <ul class="mt-3 space-y-1">
          {seo.issues.map((i) => (
            <li class:list={["flex gap-2", i.level === "error" ? "text-down-700" : i.level === "warn" ? "text-gold-700" : "text-up-700"]}>
              <span class="font-mono">{i.level === "ok" ? "✓" : i.level === "warn" ? "!" : "×"}</span>
              <span><strong>{i.label}.</strong> {i.detail}</span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-ink-600">
          {seo.wordCount} words · {seo.readingTime} min read · title {seo.titleLength}ch · description {seo.descriptionLength}ch
        </p>
      </details>
    </div>
  )}
</BaseLayout>
