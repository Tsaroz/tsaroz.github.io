---
import AdminLayout from "@layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
import { getSettings } from "@data";
import { AD_SLOTS } from "@data/types";

const settings = getSettings();
const notices = (settings as { notices?: Record<string, string> }).notices ?? {};
const rules = [
  { label: "Vote allowance", value: "one vote per ranking, 3 per site, rolling 24 hours (enforced in Postgres)" },
  { label: "Votes per entry", value: "1 (switching replaces, no extra slot)" },
  { label: "Identity", value: "Google sign-in required; email stored, nickname displayed" },
  { label: "Score formula", value: "net = upvotes minus downvotes" },
  { label: "Admin position control", value: "none, ever" },
];
---

<AdminLayout title="Site settings" heading="Site settings" sub="Ads and design defaults save immediately.">
  <div class="grid gap-6" data-settings-form>
    <section class="nr-card p-5">
      <h2 class="flex items-center gap-2 font-display text-base font-bold">
        <Icon name="lucide:megaphone" class="size-4.5 text-gold-600" aria-hidden="true" /> Ad positions
      </h2>
      <label class="mt-3 flex w-fit cursor-pointer items-center gap-2.5 rounded-lg border border-ink-200 bg-ink-50 px-3.5 py-2 text-sm font-semibold">
        <input type="checkbox" data-ads-enabled class="size-4 accent-brand-600" checked={settings.ads.enabled} />
        Ads enabled
      </label>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {AD_SLOTS.map((slot) => (
          <label class="block text-sm">
            <span class="mb-1 block font-mono text-xs font-semibold text-ink-800">{slot}</span>
            <textarea data-ad-code={slot} rows="3" placeholder="Ad HTML for this slot (or empty)" class="w-full rounded-lg border border-ink-200 p-2.5 font-mono text-xs">{settings.ads.code[slot] ?? ""}</textarea>
          </label>
        ))}
      </div>
      <p class="mt-3 text-xs text-ink-500">Slots: home_top, home_between, category_top, city_top, ranking_top, ranking_inline (after #5), entry_top, entry_after_comments, search_top, sitewide_bottom.</p>
    </section>

    <section class="nr-card p-5">
      <h2 class="flex items-center gap-2 font-display text-base font-bold">
        <Icon name="lucide:palette" class="size-4.5 text-brand-600" aria-hidden="true" /> Design defaults
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <label class="block text-sm"><span class="mb-1 block font-semibold">Theme</span>
          <select data-design-theme class="w-full rounded-lg border border-ink-200 bg-white px-3 py-2 text-sm">
            {["auto", "light", "dark"].map((t) => <option value={t} selected={settings.design.theme === t}>{t}</option>)}
          </select></label>
        <label class="block text-sm"><span class="mb-1 block font-semibold">Font</span>
          <select data-design-font class="w-full rounded-lg border border-ink-200 bg-white px-3 py-2 text-sm">
            {["default", "serif", "grotesk", "mono"].map((t) => <option value={t} selected={settings.design.font === t}>{t}</option>)}
          </select></label>
        <label class="block text-sm"><span class="mb-1 block font-semibold">Text size</span>
          <select data-design-size class="w-full rounded-lg border border-ink-200 bg-white px-3 py-2 text-sm">
            {["sm", "md", "lg", "xl"].map((t) => <option value={t} selected={settings.design.size === t}>{t}</option>)}
          </select></label>
        <label class="block text-sm"><span class="mb-1 block font-semibold">Brand colour</span>
          <input type="color" data-design-brand value={settings.design.brand || "#1e46cc"} class="h-9 w-full cursor-pointer rounded-lg border border-ink-200" /></label>
      </div>
    </section>

    <section class="nr-card p-5">
      <h2 class="flex items-center gap-2 font-display text-base font-bold">
        <Icon name="lucide:megaphone" class="size-4.5 text-brand-600" aria-hidden="true" /> Announcement bars
      </h2>
      <p class="mt-2 text-xs text-ink-500">Shown at the top of matching pages (HTML allowed, links, &lt;strong&gt;, line breaks). Leave empty to hide. Changes go live with the next site update.</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {(["home", "category", "ranking", "entry"] as const).map((sc) => (
          <label class="block text-sm">
            <span class="mb-1 block font-mono text-xs font-semibold text-ink-800">{sc} page</span>
            <textarea data-notice={sc} rows="2" placeholder="empty = hidden" class="w-full rounded-lg border border-ink-200 p-2.5 text-xs">{notices[sc] ?? ""}</textarea>
          </label>
        ))}
      </div>
    </section>

    <div class="flex gap-3">
      <button type="button" data-save class="nr-btn-primary">Save all settings</button>
    </div>

    <section class="nr-card p-5">
      <h2 class="flex items-center gap-2 font-display text-base font-bold"><Icon name="lucide:scale" class="size-4.5 text-brand-600" aria-hidden="true" /> Voting configuration (immutable)</h2>
      <dl class="mt-4 divide-y divide-ink-100 text-sm">
        {rules.map((r) => (
          <div class="flex items-center justify-between gap-4 py-3"><dt class="font-medium text-ink-600">{r.label}</dt><dd class="text-right text-xs font-semibold text-ink-900">{r.value}</dd></div>
        ))}
      </dl>
    </section>
  </div>

  <script>
    import { getSettings, saveSettings, adminGuard } from "@lib/adminclient";
    import { adminToast } from "@lib/admin";

    const form = document.querySelector<HTMLElement>("[data-settings-form]")!;
    async function prefill() {
      const dbSettings = await getSettings();
      if (dbSettings) {
        form.querySelector<HTMLInputElement>("[data-ads-enabled]")!.checked = dbSettings.ads.enabled;
        form.querySelectorAll<HTMLTextAreaElement>("[data-ad-code]").forEach((t) => (t.value = dbSettings.ads.code[t.dataset.adCode!] ?? ""));
        (form.querySelector("[data-design-theme]") as HTMLSelectElement).value = dbSettings.design.theme;
        (form.querySelector("[data-design-font]") as HTMLSelectElement).value = dbSettings.design.font;
        (form.querySelector("[data-design-size]") as HTMLSelectElement).value = dbSettings.design.size;
        if (dbSettings.design.brand) (form.querySelector("[data-design-brand]") as HTMLInputElement).value = dbSettings.design.brand;
        form.querySelectorAll<HTMLTextAreaElement>("[data-notice]").forEach((t) => (t.value = dbSettings.notices?.[t.dataset.notice!] ?? ""));
      }
    }

    form.querySelector<HTMLButtonElement>("[data-save]")!.addEventListener("click", async () => {
      if (!adminGuard()) return;
      const code: Record<string, string> = {};
      form.querySelectorAll<HTMLTextAreaElement>("[data-ad-code]").forEach((t) => (code[t.dataset.adCode!] = t.value));
      const noticesPayload: Record<string, string> = {};
      form.querySelectorAll<HTMLTextAreaElement>("[data-notice]").forEach((t) => (noticesPayload[t.dataset.notice!] = t.value));
      try {
        await saveSettings({
          notices: noticesPayload,
          ads: { enabled: form.querySelector<HTMLInputElement>("[data-ads-enabled]")!.checked, code },
          design: {
            theme: (form.querySelector("[data-design-theme]") as HTMLSelectElement).value as "light" | "dark" | "auto",
            font: (form.querySelector("[data-design-font]") as HTMLSelectElement).value as "default" | "serif" | "grotesk" | "mono",
            size: (form.querySelector("[data-design-size]") as HTMLSelectElement).value as "sm" | "md" | "lg" | "xl",
            brand: (form.querySelector("[data-design-brand]") as HTMLInputElement).value,
          },
        });
        adminToast("Settings saved.");
      } catch (err) { adminToast(`Save failed: ${String(err)} (admins only)`, false); }
    });

    prefill().catch(() => {});
  </script>
</AdminLayout>
