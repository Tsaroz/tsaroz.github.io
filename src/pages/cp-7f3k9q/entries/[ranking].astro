---
import AdminLayout from "@layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
import { url, formatNumber } from "@utils/url";
import { getRankings, getRankedEntries, netScore, type Ranking } from "@data";
import { CP } from "@lib/config";

export async function getStaticPaths() {
  return getRankings().map((r) => ({ params: { ranking: r.slug }, props: { ranking: r } }));
}

const { ranking } = Astro.props as { ranking: Ranking };
const rows = getRankedEntries(ranking.id);
const ranks = getRankings().sort((a, b) => a.title.localeCompare(b.title));
---

<AdminLayout title={`Entries · ${ranking.title}`} heading={`Entries in “${ranking.title}”`} sub={`${rows.length} entries. Baselines live in the database; live votes ride on top automatically.`}>
  <section class="nr-card mb-6 p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a href={url(`${CP}/entries/`)} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800">
        <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
        All rankings
      </a>
      <label class="flex items-center gap-2 text-sm text-ink-600">
        <span class="font-semibold">Switch ranking</span>
        <select data-switch class="max-w-64 rounded-lg border border-ink-200 bg-white px-3 py-2 text-sm">
          {ranks.map((r) => <option value={url(`${CP}/entries/${r.slug}/`)} selected={r.id === ranking.id}>{r.title}</option>)}
        </select>
      </label>
    </div>
  </section>

  <section class="nr-card mb-6 p-5">
    <h2 class="font-display text-base font-bold">Add an entry</h2>
    <p class="mt-1 text-xs text-ink-500">New entries land in “{ranking.title}” · they appear publicly after the next site update.</p>
    <form data-add data-ranking={ranking.id} data-cat={ranking.categoryId} class="mt-4 grid gap-3 sm:grid-cols-4">
      <input name="name" required placeholder="Name" class="rounded-lg border border-ink-200 px-3 py-2 text-sm" />
      <input name="upvotes" type="number" min="0" value="0" class="rounded-lg border border-ink-200 px-3 py-2 text-sm" aria-label="Baseline upvotes" />
      <button type="submit" class="rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white">Create</button>
      <input name="description" placeholder="Description" class="rounded-lg border border-ink-200 px-3 py-2 text-sm sm:col-span-4" />
    </form>
  </section>

  {rows.length === 0 ? (
    <div class="nr-card p-8 text-center">
      <Icon name="lucide:bookmark" class="mx-auto size-8 text-ink-300" aria-hidden="true" />
      <p class="mt-3 font-display text-sm font-bold">No entries in this ranking yet</p>
      <p class="mt-1 text-sm text-ink-500">Add the first one above; it appears in the database right away.</p>
    </div>
  ) : (
    <div class="nr-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="nr-cards w-full text-left text-sm">
          <thead>
            <tr class="border-b border-ink-100 bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
              <th class="px-5 py-3 font-semibold">#</th>
              <th class="px-5 py-3 font-semibold">Entry</th>
              <th class="px-5 py-3 text-right font-semibold">Up</th>
              <th class="px-5 py-3 text-right font-semibold">Down</th>
              <th class="px-5 py-3 text-right font-semibold">Net</th>
              <th class="px-5 py-3 font-semibold">Edit baseline / text</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {rows.map((e) => (
              <tr class="hover:bg-ink-50/60" data-row={e.id}>
                <td class="px-5 py-3 text-right font-display font-bold tabular-nums text-ink-400" data-label="Rank">{e.rank}</td>
                <td class="px-5 py-3" data-label="Entry">
                  <a href={url(`/ranking/${ranking.slug}/${e.slug}/`)} class="block max-w-52 truncate font-semibold text-ink-900 hover:text-brand-700">{e.name}</a>
                  <span class="block max-w-52 truncate text-xs text-ink-500">{e.description}</span>
                </td>
                <td class="px-5 py-3 text-right tabular-nums text-up-700" data-label="Upvotes">{formatNumber(e.upvotes)}</td>
                <td class="px-5 py-3 text-right tabular-nums text-down-700" data-label="Downvotes">{formatNumber(e.downvotes)}</td>
                <td class="px-5 py-3 text-right font-semibold tabular-nums" data-label="Net">{formatNumber(netScore(e))}</td>
                <td class="px-5 py-3" data-label="Edit">
                  <details class="min-w-64">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1 rounded-md border border-ink-200 px-3 py-1.5 text-xs font-semibold text-ink-600 hover:border-brand-400 hover:text-brand-700 [&::-webkit-details-marker]:hidden">Edit</summary>
                    <div class="mt-2 grid w-full gap-2 rounded-lg border border-ink-200 bg-white p-3 shadow-card">
                      <label class="block text-xs"><span class="mb-1 block font-semibold text-ink-800">Name</span>
                        <input data-f="name" value={e.name} class="w-full rounded-md border border-ink-200 px-3 py-2 text-sm" /></label>
                      <label class="block text-xs"><span class="mb-1 block font-semibold text-ink-800">Description</span>
                        <textarea data-f="description" rows="2" class="w-full rounded-md border border-ink-200 px-3 py-2 text-sm">{e.description}</textarea></label>
                      <span class="flex gap-2">
                        <label class="block min-w-0 flex-1 text-xs"><span class="mb-1 block font-semibold text-ink-800">Baseline upvotes</span>
                          <input data-f="upvotes" type="number" min="0" value={e.upvotes} class="w-full rounded-md border border-ink-200 px-3 py-2 text-sm tabular-nums" /></label>
                        <label class="block min-w-0 flex-1 text-xs"><span class="mb-1 block font-semibold text-ink-800">Baseline downvotes</span>
                          <input data-f="downvotes" type="number" min="0" value={e.downvotes} class="w-full rounded-md border border-ink-200 px-3 py-2 text-sm tabular-nums" /></label>
                      </span>
                      <button type="button" data-save class="w-full rounded-md bg-brand-600 px-3 py-2 text-sm font-semibold text-white hover:bg-brand-700">Save</button>
                    </div>
                  </details>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <script>
    import { insert, update, rpc, nowIso, slugify, adminGuard, saved } from "@lib/adminclient";
    import { adminToast } from "@lib/admin";
    document.querySelector<HTMLSelectElement>("[data-switch]")?.addEventListener("change", (e) => {
      const sel = e.target as HTMLSelectElement;
      if (sel.value) location.href = sel.value;
    });
    if (adminGuard()) {
      const form = document.querySelector<HTMLFormElement>("[data-add]")!;
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const f = Object.fromEntries(new FormData(form));
        const slug = slugify(String(f.name));
        try {
          await insert("cat_entries", {
            id: `${form.dataset.ranking}:${slug}`, ranking_id: form.dataset.ranking,
            category_id: form.dataset.cat,
            name: f.name, slug, description: f.description ?? "",
            upvotes: Number(f.upvotes) || 0, downvotes: 0,
            created_at: nowIso(), updated_at: nowIso(),
          });
          saved("Entry created.");
          form.reset();
        } catch (err) { adminToast(String(err), false); }
      });
      document.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
        row.querySelector("[data-save]")!.addEventListener("click", async () => {
          const get = (n: string) => (row.querySelector(`[data-f="${n}"]`) as HTMLInputElement | HTMLTextAreaElement).value;
          const id = row.dataset.row!;
          try {
            await rpc("update_entry_baseline", { p_entry: id, p_up: Number(get("upvotes")), p_down: Number(get("downvotes")) });
            await update("cat_entries", `id=eq.${id}`, { name: get("name"), description: get("description"), updated_at: nowIso() });
            saved("Baseline + text saved.");
          } catch (err) { adminToast(String(err), false); }
        });
      });
    }
  </script>
</AdminLayout>
