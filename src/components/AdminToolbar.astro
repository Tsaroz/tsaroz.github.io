---

---
<div class="border-b border-ink-200 bg-ink-50">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-1.5 px-5 py-2 text-xs text-ink-600">
    <strong class="font-semibold text-ink-900">NepalRanks Admin</strong>
    <span>writes go straight to the live database, enforced by row-level security</span>
    <span class="ml-auto flex items-center gap-2">
      <button type="button" data-publish hidden class="rounded-md border border-brand-500 px-2.5 py-1 font-semibold text-brand-700 hover:bg-brand-50 disabled:opacity-50">Publish site</button>
      <button type="button" data-staff-signin hidden class="rounded-md bg-brand-600 px-2.5 py-1 font-semibold text-white hover:bg-brand-700">Sign in with Google</button>
      <button type="button" data-staff-signout hidden class="rounded-md border border-ink-300 px-2.5 py-1 font-semibold text-ink-600 hover:bg-ink-100">Sign out</button>
      <span data-staff-badge class="rounded-full bg-ink-200 px-2.5 py-1 font-semibold text-ink-600">checking…</span>
    </span>
  </div>
</div>

<script>
  import { userRole, session, requireAuth, signOut, sb } from "@lib/auth";
  import { list, rpc } from "@lib/store";
  import { adminToast } from "@lib/admin";
  const ATTEMPT_KEY = "nr-signin-attempt";
  const badge = document.querySelector<HTMLElement>("[data-staff-badge]")!;
  const inBtn = document.querySelector<HTMLButtonElement>("[data-staff-signin]")!;
  const outBtn = document.querySelector<HTMLButtonElement>("[data-staff-signout]")!;
  const pubBtn = document.querySelector<HTMLButtonElement>("[data-publish]")!;
  pubBtn.addEventListener("click", async () => {
    pubBtn.disabled = true;
    pubBtn.textContent = "publishing…";
    try {
      const r = await rpc<{ ok: boolean; error?: string }>("request_publish", {});
      if (!r?.ok) throw new Error(r?.error ?? "dispatch failed");
      adminToast("Publish dispatched, pages refresh in about two minutes.");
    } catch (e) {
      adminToast(String(e), false);
    }
    setTimeout(() => { pubBtn.disabled = false; pubBtn.textContent = "Publish site"; }, 95000);
  });
  inBtn.addEventListener("click", () => {
    try { localStorage.setItem(ATTEMPT_KEY, String(Date.now())); } catch {}
    void requireAuth(location.href);
  });
  outBtn.addEventListener("click", () => { void signOut(); });
  (async () => {
    const params = new URLSearchParams(location.search);
    const hadCode = params.has("code");
    const attempt = Number(localStorage.getItem(ATTEMPT_KEY) || 0);
    let s = await session();
    if (!s && hadCode) {
      try {
        const r = await sb()?.auth.exchangeCodeForSession(params.get("code")!);
        s = r?.data.session ?? null;
      } catch {
        s = await session();
      }
      history.replaceState({}, "", location.pathname);
    }
    if (s) localStorage.removeItem(ATTEMPT_KEY);
    if (!s && hadCode) {
      badge.textContent = "sign-in code rejected (used already or expired) — click Sign in once more";
      badge.className = "rounded-full bg-down-100 px-2.5 py-1 font-semibold text-down-700";
      inBtn.hidden = false;
      return;
    }
    if (!s && attempt && Date.now() - attempt < 180000) {
      localStorage.removeItem(ATTEMPT_KEY);
      badge.textContent = "Supabase never returned the code to this domain — the Redirect URL is not being honored";
      badge.className = "rounded-full bg-down-100 px-2.5 py-1 font-semibold text-down-700";
      inBtn.hidden = false;
      return;
    }
    if (!s) {
      badge.textContent = "not signed in, read-only";
      inBtn.hidden = false;
      return;
    }
    const role = await userRole();
    outBtn.hidden = false;
    if (!role) {
      badge.textContent = "signed in · no staff role (read-only)";
      badge.className = "rounded-full bg-gold-100 px-2.5 py-1 font-semibold text-gold-700";
      return;
    }
    try {
      const rows = await list<Array<{ id: string }>>("cat_entries", "?select=id&limit=1");
      const seeded = rows.length > 0;
      badge.textContent = seeded ? `signed in · ${role}` : `signed in · ${role} · backend not ready`;
      badge.className = "rounded-full px-2.5 py-1 font-semibold " + (seeded ? "bg-up-100 text-up-700" : "bg-down-100 text-down-700");
    } catch {
      badge.textContent = `signed in · ${role}`;
      badge.className = "rounded-full bg-up-100 px-2.5 py-1 font-semibold text-up-700";
    }
    if (role === "admin" || role === "moderator") {
      pubBtn.hidden = false;
    }
  })();
</script>
