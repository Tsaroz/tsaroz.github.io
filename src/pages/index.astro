---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArticleCard from "@components/ArticleCard.astro";
import { Icon } from "astro-icon/components";
import { getArticles } from "@lib/articles";
import { url } from "@utils/url";

const articles = await getArticles();
const featured = articles.filter((a) => a.data.featured);
const lead = featured[0] ?? articles[0];
const rest = articles.filter((a) => a !== lead);
const comparisons = articles.filter((a) => a.data.articleType !== "info" && a.data.products.length > 0).length;
const guides = articles.length - comparisons;
const site = Astro.site ?? new URL("https://nepalranks.com");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "NepalRanks",
  url: site.href,
  description: "Independent, in-depth buying guides and rankings for products and services in Nepal.",
  inLanguage: "en",
};
---

<BaseLayout
  title="NepalRanks — Expert Buying Guides & Rankings for Nepal"
  description="Independent, in-depth buying guides, honest comparisons and rankings for products and services in Nepal. Research-backed picks you can trust."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b-2" style="border-color: var(--nr-border); background: var(--nr-bg-sunken);">
    <div class="nr-stripes absolute inset-x-0 top-0 h-2 opacity-30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="nr-badge" style="background: var(--nr-crimson); color: #fff;">
            <Icon name="lucide:sparkles" class="size-3" aria-hidden="true" /> Independent · Research-backed
          </span>
          <span class="nr-badge" style="background: var(--nr-bg-raised); color: var(--nr-text-muted);">
            Est. 2026
          </span>
        </div>
        <h1 class="mt-5 font-display text-4xl font-bold leading-[1.02] tracking-tight sm:text-5xl lg:text-6xl">
          Buy smarter in
          <span class="relative inline-block">
            <span class="relative z-10">Nepal.</span>
            <span class="absolute inset-x-0 bottom-1 z-0 h-3 sm:h-4" style="background: var(--nr-gold);"></span>
          </span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8" style="color: var(--nr-text-muted);">
          In-depth buying guides, honest comparisons and rankings for the products and services
          that matter in Nepal — researched, tested and written by people who live here.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={url("/articles/")} class="nr-btn nr-btn-primary">
            Browse all guides <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a href={url("/about/")} class="nr-btn nr-btn-outline">How we rank</a>
        </div>

        <dl class="mt-10 flex flex-wrap gap-3">
          <div class="nr-panel px-4 py-3">
            <dt class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">Comparisons</dt>
            <dd class="font-display text-2xl font-bold">{comparisons}</dd>
          </div>
          <div class="nr-panel px-4 py-3">
            <dt class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">Explainers</dt>
            <dd class="font-display text-2xl font-bold">{guides}</dd>
          </div>
          <div class="nr-panel px-4 py-3">
            <dt class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">Products ranked</dt>
            <dd class="font-display text-2xl font-bold">
              {articles.reduce((n, a) => n + a.data.products.length, 0)}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {lead && (
    <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="nr-label">Editor's pick</p>
          <h2 class="mt-1 font-display text-2xl font-bold sm:text-3xl">Start here</h2>
        </div>
      </div>
      <ArticleCard article={lead} featured />
    </section>
  )}

  {rest.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6" aria-labelledby="latest-h">
      <div class="mb-6 flex items-end justify-between gap-4 border-b-2 pb-3" style="border-color: var(--nr-border);">
        <h2 id="latest-h" class="font-display text-2xl font-bold sm:text-3xl">Latest guides</h2>
        <a href={url("/articles/")} class="inline-flex items-center gap-1 text-sm font-bold hover:underline" style="color: var(--nr-accent);">
          All articles <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  {articles.length === 0 && (
    <section class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6">
      <p style="color: var(--nr-text-muted);">No articles yet. Add one from the admin panel.</p>
    </section>
  )}
</BaseLayout>
