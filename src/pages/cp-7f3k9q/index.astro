---
import AdminLayout from "@layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
import { url, formatNumber, timeAgo } from "@utils/url";
import { getCategories, allDecorated, getRankings } from "@data";
import { entries } from "@data/entries";

const decorated = allDecorated();
const totals = {
  votes: entries.reduce((s, e) => s + e.upvotes + e.downvotes, 0),
  comments: decorated.reduce((s, r) => s + r.commentCount, 0),
};
const recent = [...decorated].sort((a, b) => +new Date(b.updatedAt) - +new Date(a.updatedAt)).slice(0, 6);
const stats = [
  { label: "Categories", value: String(getCategories().length), icon: "lucide:tags" },
  { label: "Rankings", value: String(getRankings().length), icon: "lucide:list-ordered" },
  { label: "Ranked entries", value: String(entries.length), icon: "lucide:bookmark" },
  { label: "Votes", value: formatNumber(totals.votes), icon: "lucide:vote" },
  { label: "Comments", value: formatNumber(totals.comments), icon: "lucide:messages-square" },
];
---

<AdminLayout title="Dashboard" heading="Dashboard" sub="Activity and totals.">
  <section class="nr-card mb-6 p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="flex items-center gap-2 font-display text-base font-bold">
        <Icon name="lucide:radio" class="size-4.5 text-up-600" aria-hidden="true" />
        Live activity right now
      </h2>
      <span data-live-status class="nr-badge bg-ink-100 text-ink-500">connecting…</span>
    </div>
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-3">
      <div class="rounded-lg bg-ink-50 p-3"><dt class="nr-label">Live votes</dt><dd class="mt-1 font-display text-xl font-bold tabular-nums" data-live-votes>—</dd></div>
      <div class="rounded-lg bg-ink-50 p-3"><dt class="nr-label">Comments waiting review</dt><dd class="mt-1 font-display text-xl font-bold tabular-nums" data-live-pending>—</dd></div>
      <div class="rounded-lg bg-ink-50 p-3"><dt class="nr-label">Staff power</dt><dd class="mt-1 font-display text-xl font-bold" data-live-role>—</dd></div>
    </dl>
    <ul class="mt-4 space-y-1 text-sm" data-live-top></ul>
    <p class="mt-3 flex items-center gap-2 rounded-lg bg-brand-50 px-3 py-2 text-xs text-brand-900">
      <Icon name="lucide:calendar-clock" class="size-4 shrink-0" aria-hidden="true" />
      New votes and comments are counted automatically.
    </p>
  </section>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {stats.map((s) => (
      <div class="nr-card p-4">
        <span class="grid size-9 place-items-center rounded-lg bg-brand-50 text-brand-700"><Icon name={s.icon} class="size-4.5" aria-hidden="true" /></span>
        <p class="mt-3 font-display text-2xl font-bold tabular-nums">{s.value}</p>
        <p class="text-xs font-medium uppercase tracking-wide text-ink-500">{s.label}</p>
      </div>
    ))}
  </div>

  <section class="nr-card mt-8 overflow-hidden">
    <div class="border-b border-ink-100 px-5 py-4">
      <h2 class="font-display text-base font-bold">Recently updated rankings</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="nr-cards w-full text-left text-sm">
        <thead>
          <tr class="text-xs uppercase tracking-wide text-ink-500">
            <th class="px-5 py-3 font-semibold">Ranking</th>
            <th class="px-5 py-3 font-semibold">Category</th>
            <th class="px-5 py-3 text-right font-semibold">Votes</th>
            <th class="px-5 py-3 text-right font-semibold">Leader</th>
            <th class="px-5 py-3 text-right font-semibold">Updated</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          {recent.map((r) => (
            <tr>
              <td class="px-5 py-3"><a href={url(`/ranking/${r.slug}/`)} class="font-semibold hover:text-brand-700">{r.title}</a></td>
              <td class="px-5 py-3 text-ink-600">{r.category?.name}</td>
              <td class="px-5 py-3 text-right tabular-nums">{formatNumber(r.totalVotes)}</td>
              <td class="px-5 py-3 text-right">{r.top[0]?.name}</td>
              <td class="px-5 py-3 text-right text-xs text-ink-500">{timeAgo(r.updatedAt)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script>
    import { list, userRole, adminGuard } from "@lib/adminclient";

    (async () => {
      const badge = document.querySelector<HTMLElement>("[data-live-status]")!;
      const role = await userRole();
      document.querySelector("[data-live-role]")!.textContent = role || "visitor (read-only)";
      if (!adminGuard()) { badge.textContent = "offline"; return; }
      try {
        const [deltas, pending] = await Promise.all([
          list<{ entry_id: string; up: number; down: number }>("live_deltas", "?select=entry_id,up,down"),
          list<{ id: string }>("moderation_queue", "?select=id&status=eq.pending&limit=100"),
        ]);
        const votes = deltas.reduce((s, d) => s + d.up + d.down, 0);
        document.querySelector("[data-live-votes]")!.textContent = `+${votes}`;
        document.querySelector("[data-live-pending]")!.textContent = String(pending.length);
        badge.textContent = role ? "database connected" : "connected (read-only)";
        badge.className = "nr-badge bg-up-100 text-up-700";
        const top = deltas.sort((a, b) => b.up + b.down - (a.up + a.down)).slice(0, 5);
        if (top.length) {
          const { entryNames } = await import("@lib/adminclient");
          const names = await entryNames();
          document.querySelector("[data-live-top]")!.innerHTML = top
            .map((d) => `<li class="flex items-center justify-between rounded-lg bg-ink-50 px-3 py-1.5"><span class="min-w-0 truncate">${d.entry_id.split(":").pop()}</span><span class="tabular-nums font-semibold text-up-700">+${d.up} up; ${d.down} down</span></li>`)
            .join("");
          void names;
        }
      } catch (err) {
        badge.textContent = "database unreachable";
        badge.className = "nr-badge bg-down-100 text-down-700";
        console.warn(err);
      }
    })();
  </script>
</AdminLayout>
