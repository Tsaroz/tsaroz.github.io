---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import NoticeBar from "@components/NoticeBar.astro";
import AdSlot from "@components/AdSlot.astro";
import RankingCard from "@components/RankingCard.astro";
import { Icon } from "astro-icon/components";
import { getCategories, getRankingsForCategorySlug, categoryStats, getCategoryBySlug, decorate } from "@data";
import { timeAgo } from "@utils/url";
import { IS_LIVE } from "@lib/config";

export function getStaticPaths() {
  return getCategories().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug!);
if (!category) return Astro.redirect("/404/");

const decorated = getRankingsForCategorySlug(slug!).map(decorate);
const stats = categoryStats(slug!);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: String(new URL("categories/", Astro.site)) },
    { "@type": "ListItem", position: 2, name: category.name, item: String(new URL(`category/${category.slug}/`, Astro.site)) },
  ],
};
---

<BaseLayout
  title={`${category.name} Rankings | NepalRanks`}
  description={`${category.description} ${stats.rankings} community-voted rankings with ${stats.entries} entries.${IS_LIVE ? " Voted live, published daily." : " Design preview with fictional sample data."}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <Breadcrumbs items={[{ name: "Categories", href: "/categories/" }, { name: category.name }]} />

  <header class="nr-container pb-8">
    <div class="nr-card flex flex-col gap-5 bg-ink-50/70 p-6 sm:flex-row sm:items-start">
      <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-brand-600 text-white">
        <Icon name={category.icon} class="size-7" aria-hidden="true" />
      </span>
      <div class="min-w-0">
        <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{category.name}</h1>
        <p class="mt-2 max-w-3xl text-sm leading-7 text-ink-600 sm:text-base">{category.description}</p>
        <p class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-ink-600">
          <span class="inline-flex items-center gap-1.5 font-medium">
            <Icon name="lucide:list-ordered" class="size-4 text-brand-600" aria-hidden="true" />
            {stats.rankings} rankings
          </span>
          <span class="inline-flex items-center gap-1.5 font-medium">
            <Icon name="lucide:boxes" class="size-4 text-brand-600" aria-hidden="true" />
            {stats.entries} ranked entries
          </span>
          <span class="inline-flex items-center gap-1.5">Updated {timeAgo(category.updatedAt)}</span>
        </p>
      </div>
    </div>
  </header>

  <NoticeBar scope="category" />

  <AdSlot name="category_top" />

  <section class="nr-container pt-8" aria-label="Rankings in this category">
    <div class="mb-5 flex flex-wrap items-center gap-3">
      <div class="relative flex-1 basis-64">
        <Icon name="lucide:search" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-ink-400" aria-hidden="true" />
        <label for="filter" class="sr-only">Filter rankings in {category.name}</label>
        <input
          id="filter"
          type="search"
          data-filter-input
          placeholder="Filter rankings…"
          class="w-full rounded-lg border border-ink-200 bg-white py-2 pl-9 pr-3 text-sm placeholder:text-ink-400 focus:border-brand-400"
        />
      </div>
      <div class="flex items-center gap-1 rounded-lg border border-ink-200 bg-white p-1 text-sm" role="group" aria-label="Sort rankings">
        <button type="button" data-sort="votes" data-sort-active class="sort-btn rounded-md px-3 py-1.5 font-medium">Most popular</button>
        <button type="button" data-sort="updated" class="sort-btn rounded-md px-3 py-1.5 font-medium text-ink-600 hover:text-ink-800">Recently updated</button>
      </div>
    </div>

    <div id="ranking-grid" class="grid items-stretch gap-4 md:grid-cols-2 xl:grid-cols-3">
      {decorated.map((r) => (
        <div data-filter-item data-title={r.title.toLowerCase()} data-votes={r.totalVotes} data-updated={+new Date(r.updatedAt)}>
          <RankingCard ranking={r} />
        </div>
      ))}
    </div>
    <p data-filter-empty class="hidden py-10 text-center text-sm text-ink-600">
      No rankings match your filter.
    </p>
  </section>

  <script>
    const grid = document.getElementById("ranking-grid");
    const input = document.querySelector<HTMLInputElement>("[data-filter-input]");
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]");
    if (!grid || !input) throw new Error("category controls missing");

    const items = [...grid.querySelectorAll<HTMLElement>("[data-filter-item]")];

    function apply() {
      const q = input!.value.trim().toLowerCase();
      let shown = 0;
      for (const it of items) {
        const hit = !q || it.dataset.title!.includes(q);
        it.hidden = !hit;
        if (hit) shown++;
      }
      empty!.classList.toggle("hidden", shown > 0);
    }
    input.addEventListener("input", apply);

    document.querySelectorAll<HTMLButtonElement>(".sort-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".sort-btn").forEach((b) => {
          b.removeAttribute("data-sort-active");
          b.classList.add("text-ink-600");
        });
        btn.setAttribute("data-sort-active", "");
        btn.classList.remove("text-ink-600");
        const key = btn.dataset.sort === "votes" ? "votes" : "updated";
        items
          .sort((a, b) => Number(b.dataset[key] ?? 0) - Number(a.dataset[key] ?? 0))
          .forEach((it) => grid.appendChild(it));
      });
    });
  </script>
  <style>
    [data-sort-active] {
      background: var(--color-brand-50);
      color: var(--color-brand-700);
    }
  </style>
</BaseLayout>
