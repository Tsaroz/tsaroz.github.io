---
import type { DecoratedRanking } from "@data";
import { netScore } from "@data";
import { Icon } from "astro-icon/components";
import { url, formatNumber, timeAgo } from "@utils/url";

interface Props {
  ranking: DecoratedRanking;

  preview?: boolean;
}

const { ranking, preview = true } = Astro.props;
const href = `/ranking/${ranking.slug}/`;
---

<article class="nr-card group relative flex h-full flex-col p-5 transition-shadow hover:shadow-card-hover">
  <div class="flex items-center gap-2">
    {ranking.category && (
      <a
        href={url(`/category/${ranking.category.slug}/`)}
        class="nr-badge relative z-10 bg-brand-50 text-brand-700 hover:bg-brand-100"
      >
        <Icon name={ranking.category.icon} class="size-3.5" aria-hidden="true" />
        {ranking.category.name}
      </a>
    )}
  </div>

  <h3 class="mt-3 font-display text-lg font-bold leading-snug">
    <a href={url(href)} class="text-ink-900 transition-colors group-hover:text-brand-700">
      {ranking.title}
      <span class="absolute inset-0" aria-hidden="true"></span>
    </a>
  </h3>
  <p class="mt-1.5 line-clamp-2 text-sm leading-6 text-ink-600">{ranking.description}</p>

  {preview && (
    <ol class="mt-4 space-y-1.5" aria-label={`Current top three of ${ranking.title}`}>
      {ranking.top.map((e) => (
        <li class="flex items-center gap-2.5 rounded-lg bg-ink-50 px-3 py-1.5 text-sm">
          <span class:list={["w-4 text-center font-display font-bold tabular-nums", e.rank <= 3 ? "text-gold-600" : "text-ink-500"]}>{e.rank}</span>
          <a href={url(`/ranking/${ranking.slug}/${e.slug}/`)} class="relative z-10 min-w-0 flex-1 truncate font-medium text-ink-800 hover:text-brand-700">{e.name}</a>
          <span class="flex items-center gap-1 text-xs font-semibold tabular-nums text-up-700">
            <Icon name="lucide:arrow-up-right" class="size-3" aria-hidden="true" />
            {formatNumber(netScore(e))}
          </span>
        </li>
      ))}
    </ol>
  )}

  <footer class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-ink-100 pt-4 text-xs text-ink-500">
    <span class="inline-flex items-center gap-1.5">
      <Icon name="lucide:list-ordered" class="size-3.5" aria-hidden="true" />
      {ranking.entryCount} entries
    </span>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="lucide:vote" class="size-3.5" aria-hidden="true" />
      {formatNumber(ranking.totalVotes)} votes
    </span>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="lucide:messages-square" class="size-3.5" aria-hidden="true" />
      {ranking.commentCount} comments
    </span>
    <span class="ml-auto inline-flex items-center gap-1.5">
      <Icon name="lucide:clock" class="size-3.5" aria-hidden="true" />
      {timeAgo(ranking.updatedAt)}
    </span>
  </footer>
</article>
