---
import "@styles/global.css";
import { Icon } from "astro-icon/components";
import { url } from "@utils/url";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
}

const {
  title,
  description,
  noindex = false,
  ogImage,
  ogType = "website",
  publishedTime,
  modifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;

const site = Astro.site ?? new URL("https://nepalranks.com");
const canonical = new URL(Astro.url.pathname, site).href;
const defaultOg = new URL("og.png", site).href;
const resolvedOg = ogImage ? new URL(ogImage, site).href : defaultOg;
const siteName = "NepalRanks";

const year = new Date().getFullYear();
const nav = [
  { href: "/articles/", label: "Articles" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <meta name="author" content={articleAuthor ?? siteName} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_NP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOg} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {ogType === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOg} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="theme-color" content="#161b26" />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    <a
      href="#main"
      class="sr-only rounded-lg bg-brand-600 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
      >Skip to content</a
    >
    <header class="sticky top-0 z-40 border-b border-ink-200 bg-white/95 backdrop-blur">
      <div class="nr-container flex h-16 items-center justify-between gap-3">
        <a href={url("/")} class="flex shrink-0 items-center gap-2.5" aria-label="NepalRanks home">
          <span class="grid size-9 place-items-center rounded-lg bg-ink-900">
            <Icon name="lucide:list-ordered" class="size-5 text-brand-300" aria-hidden="true" />
          </span>
          <span class="leading-tight">
            <span class="block font-display text-lg font-bold tracking-tight text-ink-900"
              >Nepal<span class="text-brand-600">Ranks</span></span
            >
            <span class="hidden text-[11px] font-medium uppercase tracking-[0.14em] text-ink-600 sm:block"
              >Expert Buyers' Guides</span
            >
          </span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={url(item.href)}
              class="rounded-lg px-3 py-2 text-sm font-medium text-ink-600 hover:bg-ink-100 hover:text-ink-900"
              >{item.label}</a
            >
          ))}
        </nav>

        <details class="relative md:hidden">
          <summary
            class="grid size-9 cursor-pointer list-none place-items-center rounded-lg border border-ink-200 text-ink-700 hover:bg-ink-100 [&::-webkit-details-marker]:hidden"
          >
            <Icon name="lucide:menu" class="size-5" aria-hidden="true" />
            <span class="sr-only">Open menu</span>
          </summary>
          <div class="absolute right-0 z-40 mt-2 w-56 rounded-xl border border-ink-200 bg-white p-2 shadow-card">
            <nav aria-label="Mobile">
              <a href={url("/")} class="block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">Home</a>
              {nav.map((item) => (
                <a href={url(item.href)} class="block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100"
                  >{item.label}</a
                >
              ))}
            </nav>
          </div>
        </details>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-ink-200 bg-ink-950 text-ink-300">
      <div class="nr-container grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class="font-display text-lg font-bold text-white">Nepal<span class="text-brand-300">Ranks</span></p>
          <p class="mt-1 text-xs font-medium uppercase tracking-[0.14em] text-ink-300">Expert Buyers' Guides</p>
          <p class="mt-4 text-sm leading-6 text-ink-300">
            Independent, in-depth buying guides and rankings for products and services in Nepal.
          </p>
        </div>
        <nav aria-label="Explore">
          <p class="nr-label text-ink-300">Explore</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-white" href={url("/articles/")}>All articles</a></li>
            <li><a class="hover:text-white" href={url("/about/")}>About</a></li>
            <li><a class="hover:text-white" href={url("/contact/")}>Contact</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal">
          <p class="nr-label text-ink-300">Legal</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-white" href={url("/privacy/")}>Privacy Policy</a></li>
            <li><a class="hover:text-white" href={url("/terms/")}>Terms of Service</a></li>
          </ul>
        </nav>
        <div>
          <p class="nr-label text-ink-300">Affiliate disclosure</p>
          <p class="mt-3 text-sm leading-6 text-ink-300">
            Some links may be affiliate links. This never affects our rankings or opinions.
          </p>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="nr-container flex flex-col gap-2 py-5 text-xs text-ink-300 sm:flex-row sm:items-center sm:justify-between">
          <p>© {year} NepalRanks. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
