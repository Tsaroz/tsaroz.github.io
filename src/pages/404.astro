---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { url } from "@utils/url";
---

<BaseLayout
  title="Page not found | NepalRanks"
  description="The page you requested does not exist on NepalRanks."
  noindex
>
  <div class="nr-container flex flex-col items-center py-24 text-center">
    <span class="grid size-16 place-items-center rounded-2xl bg-ink-100 text-ink-600">
      <Icon name="lucide:compass" class="size-8" aria-hidden="true" />
    </span>
    <p class="mt-6 font-display text-6xl font-bold text-ink-900">404</p>
    <h1 class="mt-2 font-display text-2xl font-bold">This page has wandered off</h1>
    <p class="mt-3 max-w-md text-sm leading-6 text-ink-600">
      The page you were looking for doesn't exist or has moved. Try our guides instead.
    </p>
    <p class="mt-7 flex flex-wrap justify-center gap-3">
      <a href={url("/")} class="nr-btn-primary">
        <Icon name="lucide:home" class="size-4" aria-hidden="true" /> Home
      </a>
      <a href={url("/articles/")} class="nr-btn-outline">
        <Icon name="lucide:list-ordered" class="size-4" aria-hidden="true" /> All articles
      </a>
    </p>
  </div>
</BaseLayout>
