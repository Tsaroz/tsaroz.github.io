---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import NoticeBar from "@components/NoticeBar.astro";
import VoteButtons from "@components/VoteButtons.astro";
import VoteAllowance from "@components/VoteAllowance.astro";
import LiveEngage from "@components/LiveEngage.astro";
import AdSlot from "@components/AdSlot.astro";
import { Icon } from "astro-icon/components";
import {
  getRankings,
  getRankedEntriesBySlug,
  getCommentsForEntry,
  netScore,
} from "@data";
import { url, formatNumber, formatDate, timeAgo } from "@utils/url";
import { IS_LIVE } from "@lib/config";

export function getStaticPaths() {
  return getRankings().flatMap((r) =>
    getRankedEntriesBySlug(r.slug).map((e) => ({
      params: { slug: r.slug, entry: e.slug },
    })),
  );
}

const { slug, entry: entrySlug } = Astro.params;
const ranked = getRankedEntriesBySlug(slug!);
const entry = ranked.find((e) => e.slug === entrySlug);
const ranking = getRankings().find((r) => r.slug === slug);
if (!entry || !ranking) return Astro.redirect("/404/");

const comments = getCommentsForEntry(entry);
const score = netScore(entry);
const site = Astro.site ?? new URL("https://nepalranks.com");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Categories", item: String(new URL("categories/", site)) },
    { "@type": "ListItem", position: 2, name: ranking.title, item: String(new URL(`ranking/${ranking.slug}/`, site)) },
    { "@type": "ListItem", position: 3, name: entry.name, item: String(new URL(`ranking/${ranking.slug}/${entry.slug}/`, site)) },
  ],
};

---

<BaseLayout
  title={`${entry.name}, ${ranking.title} Discussion | NepalRanks`}
  description={`${entry.name} currently sits #${entry.rank} of ${ranked.length} in "${ranking.title}" with a net score of ${score} (${entry.upvotes} up; ${entry.downvotes} down). Read and discuss ${comments.length} community comments.${IS_LIVE ? " Vote and reply live." : " Design preview, fictional data."}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <AdSlot name="entry_top" />

  <Breadcrumbs
    items={[
      { name: "Categories", href: "/categories/" },
      { name: ranking.title, href: `/ranking/${ranking.slug}/` },
      { name: entry.name },
    ]}
  />

  <header class="nr-container pb-6">
    <div class="nr-card overflow-hidden">
      <div class="flex flex-col gap-5 p-5 sm:flex-row sm:p-6">
        <div class="flex items-center gap-4 sm:flex-col sm:items-center">
          <img
            src={url(entry.image)}
            alt={entry.imageAlt}
            width="112"
            height="112"
            class="size-24 shrink-0 rounded-2xl border border-ink-200 sm:size-28"
          />
          <p
            class:list={[
              "grid size-11 place-items-center rounded-xl font-display text-xl font-bold tabular-nums sm:size-12 sm:text-2xl",
              entry.rank <= 3 ? "bg-gold-100 text-gold-700 ring-2 ring-gold-500/40" : "bg-ink-100 text-ink-600",
            ]}
          >
            #{entry.rank}
            <span class="sr-only">of {ranked.length} in {ranking.title}</span>
          </p>
        </div>
        <div class="min-w-0 flex-1">
          <p class="nr-label">
            Current position: #<span>{entry.rank}</span>
            of {ranked.length} in
            <a href={url(`/ranking/${ranking.slug}/`)} class="nr-link normal-case tracking-normal">{ranking.title}</a>
          </p>
          <h1 class="mt-1.5 font-display text-3xl font-bold tracking-tight sm:text-4xl">{entry.name}</h1>
          <p class="mt-2 max-w-2xl text-sm leading-7 text-ink-600 sm:text-base">{entry.description}</p>

          <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
            <div class="flex items-center gap-2 rounded-lg bg-up-50 px-3 py-2">
              <Icon name="lucide:arrow-up" class="size-4 text-up-700" aria-hidden="true" />
              <dt class="sr-only">Upvotes</dt>
              <dd class="text-sm font-bold tabular-nums text-up-700">{formatNumber(entry.upvotes)}</dd>
              <dt class="text-xs text-ink-500">upvotes</dt>
            </div>
            <div class="flex items-center gap-2 rounded-lg bg-down-50 px-3 py-2">
              <dt class="sr-only">Downvotes</dt>
              <dd class="text-sm font-bold tabular-nums text-down-700">{formatNumber(entry.downvotes)}</dd>
              <dt class="text-xs text-ink-500">downvotes</dt>
              <Icon name="lucide:arrow-down" class="size-4 text-down-700" aria-hidden="true" />
            </div>
            <div class="flex items-center gap-2 rounded-lg bg-ink-100 px-3 py-2">
              <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">Net score</dt>
              <dd class="text-sm font-bold tabular-nums text-ink-900">{formatNumber(score)}</dd>
            </div>
          </dl>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <VoteButtons {entry} />
            <a href={url(`/ranking/${ranking.slug}/`)} class="nr-btn-outline">
              <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
              Back to full ranking
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <NoticeBar scope="entry" />

  <section class="nr-container pt-6" aria-label="Voting allowance">
    <VoteAllowance categoryId={ranking.categoryId} />
  </section>

  <section class="nr-container pt-8" aria-label="Discussion" data-discussion-entry={entry.id}>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-display text-2xl font-bold">
        <span data-comment-count>{comments.length}</span> comments
        <span class="text-sm font-normal text-ink-500">{IS_LIVE ? "(community discussion, live replies appear here)" : "(fictional sample discussion)"}</span>
      </h2>
      <div class="flex items-center gap-1 rounded-lg border border-ink-200 bg-white p-1 text-sm" role="group" aria-label="Sort comments">
        <button type="button" data-comment-sort="top" class="c-sort-btn rounded-md px-3 py-1.5 font-medium" data-active>Top</button>
        <button type="button" data-comment-sort="new" class="c-sort-btn rounded-md px-3 py-1.5 font-medium text-ink-500 hover:text-ink-800">Newest</button>
        <button type="button" data-comment-sort="old" class="c-sort-btn rounded-md px-3 py-1.5 font-medium text-ink-500 hover:text-ink-800">Oldest</button>
      </div>
    </div>

    {comments.length === 0 && (
      <p class="mb-3 rounded-lg border border-dashed border-ink-200 px-4 py-3 text-sm text-ink-500">
        No comments yet. The discussion below this ranking starts with you.
      </p>
    )}
    <ol id="comment-list" class="space-y-3">
      {comments.map((c, i) => (
        <li
          class="nr-card comment-item p-4"
          data-score={netScore(c)}
          data-ts={+new Date(c.createdAt)}
          data-index={i}
        >
          <div class="flex items-center justify-between gap-3">
            <p class="flex items-center gap-2.5 text-sm font-semibold text-ink-900">
              <span class="grid size-8 place-items-center rounded-full bg-brand-50 text-[11px] font-bold text-brand-700">
                {c.author.slice(0, 2).toUpperCase()}
              </span>
              {c.author}
            </p>
            <p class="flex items-center gap-1.5 text-xs text-ink-500">
              <span class="rounded-full bg-ink-100 px-2 py-0.5 font-semibold tabular-nums text-ink-700">{formatNumber(netScore(c))}</span>
              <span class="sr-only">score</span>
              <span class="mx-0.5 text-ink-300" aria-hidden="true">·</span>
              <time datetime={c.createdAt} title={formatDate(c.createdAt)}>{timeAgo(c.createdAt)}</time>
            </p>
          </div>
          <p class="mt-2.5 text-sm leading-7 text-ink-700">{c.body}</p>
        </li>
      ))}
    </ol>

    <nav class="mt-5 flex items-center justify-center gap-2 text-sm" aria-label="Comment pages" data-pagination>
      <button type="button" data-page-prev class="nr-btn-outline py-1.5" disabled>
        <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
        Previous
      </button>
      <span data-page-info class="px-2 tabular-nums text-ink-600">Page 1 of 1</span>
      <button type="button" data-page-next class="nr-btn-outline py-1.5">
        Next
        <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
      </button>
    </nav>
  </section>

  <section class="nr-container scroll-mt-24 pt-10" aria-label="Add a comment">
    <div class="nr-card p-5 sm:p-6">
      <h2 class="font-display text-xl font-bold">Join the discussion</h2>
      <p class="mt-1 flex items-center gap-2 text-sm text-ink-500">
        {IS_LIVE ? (
          <Icon name="lucide:message-square-plus" class="size-4 text-up-700" aria-hidden="true" />
        ) : (
          <Icon name="lucide:flask-conical" class="size-4 text-gold-600" aria-hidden="true" />
        )}
        {IS_LIVE
          ? "Be civil and specific. Comments are posted live and reviewed in the daily moderation run."
          : "Demonstration form, set a live API to enable real comments. Nothing submitted here is stored."}
      </p>
      <form data-comment-form class="mt-4 space-y-4">
        <div class="grid gap-4 sm:grid-cols-[minmax(0,220px)_1fr]">
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold text-ink-800">Display name</span>
            <input
              type="text"
              name="author"
              required
              autocomplete="off"
              placeholder="Your username"
              class="w-full rounded-lg border border-ink-200 px-3 py-2 text-sm focus:border-brand-400"
            />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold text-ink-800">Comment</span>
            <textarea
              name="body"
              required
              rows="3"
              placeholder={`Why does ${entry.name} deserve its position?`}
              class="w-full rounded-lg border border-ink-200 px-3 py-2 text-sm focus:border-brand-400"
            ></textarea>
          </label>
        </div>
        <button type="submit" class="nr-btn-primary">
          <Icon name="lucide:send" class="size-4" aria-hidden="true" />
          Post comment{IS_LIVE ? "" : " (demo)"}
        </button>
      </form>
    </div>
  </section>

  <AdSlot name="entry_after_comments" />

  <LiveEngage />

  <script>

    if (new URLSearchParams(location.search).has("respond")) {
      const form = document.querySelector<HTMLFormElement>("[data-comment-form]");
      if (form) {
        form.scrollIntoView({ block: "center", behavior: "smooth" });
        form.querySelector<HTMLInputElement>("input[name=author]")?.focus({ preventScroll: true });
      }
    }
  </script>

  <script>
    const PER_PAGE = 5;
    const list = document.getElementById("comment-list");
    if (!list) throw new Error("comment list missing");
    const items = [...list.querySelectorAll<HTMLElement>(".comment-item")];
    const info = document.querySelector<HTMLElement>("[data-page-info]")!;
    const prev = document.querySelector<HTMLButtonElement>("[data-page-prev]")!;
    const next = document.querySelector<HTMLButtonElement>("[data-page-next]")!;
    let order = [...items];
    let page = 0;

    function render() {
      const pages = Math.max(1, Math.ceil(order.length / PER_PAGE));
      page = Math.min(page, pages - 1);
      order.forEach((el) => (el.hidden = true));
      order.slice(page * PER_PAGE, page * PER_PAGE + PER_PAGE).forEach((el) => {
        el.hidden = false;
        list!.appendChild(el);
      });
      info.textContent = `Page ${page + 1} of ${pages}`;
      prev.disabled = page === 0;
      next.disabled = page >= pages - 1;
    }

    document.querySelectorAll<HTMLButtonElement>(".c-sort-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".c-sort-btn").forEach((b) => {
          b.removeAttribute("data-active");
          b.classList.add("text-ink-500");
        });
        btn.setAttribute("data-active", "");
        btn.classList.remove("text-ink-500");
        const mode = btn.dataset.commentSort;
        order = [...items].sort((a, b) => {
          if (mode === "new") return Number(b.dataset.ts) - Number(a.dataset.ts);
          if (mode === "old") return Number(a.dataset.ts) - Number(b.dataset.ts);
          return Number(b.dataset.score) - Number(a.dataset.score) || Number(a.dataset.index) - Number(b.dataset.index);
        });
        page = 0;
        render();
      });
    });

    prev.addEventListener("click", () => { page--; render(); });
    next.addEventListener("click", () => { page++; render(); });

    render();

  </script>
  <style>
    [data-active] {
      background: var(--color-brand-50);
      color: var(--color-brand-700);
    }
  </style>
</BaseLayout>
