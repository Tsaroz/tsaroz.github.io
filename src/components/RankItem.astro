---
import type { EntryWithRank, Ranking } from "@data";
import { getTopComments, countCommentsForEntry, netScore } from "@data";
import { Icon } from "astro-icon/components";
import { url, formatNumber, timeAgo } from "@utils/url";
import VoteButtons from "./VoteButtons.astro";
import CommentItem from "./CommentItem.astro";

interface Props {
  entry: EntryWithRank;
  ranking: Ranking;
}

const { entry, ranking } = Astro.props;
const comments = getTopComments(entry, 3);
const total = countCommentsForEntry(entry);
const discussion = `/ranking/${ranking.slug}/${entry.slug}/`;
const medal = entry.rank <= 3;
---

<li class="nr-card overflow-hidden transition-shadow hover:shadow-card-hover" data-entry>
  <div class="flex items-start gap-3 p-4 sm:gap-4 sm:p-5">
    <p
      class:list={[
        "grid size-8 shrink-0 place-items-center rounded-full font-display text-base font-bold tabular-nums sm:size-9 sm:text-lg",
        medal ? "bg-gold-100 text-gold-700 ring-2 ring-gold-500/40" : "bg-ink-100 text-ink-600",
      ]}
      data-rank-badge
      aria-label={`Rank ${entry.rank}`}
      title={`Position ${entry.rank}`}
    >{entry.rank}</p>
    <img
      src={url(entry.image)}
      alt={entry.imageAlt}
      width="128"
      height="128"
      loading="lazy"
      decoding="async"
      class="size-16 shrink-0 rounded-xl border border-ink-200 sm:size-[84px]"
    />
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
        <h3 class="min-w-0 flex-1 truncate font-display text-lg font-bold sm:text-xl">
          <a href={url(discussion)} class="text-ink-900 hover:text-brand-700">{entry.name}</a>
        </h3>
        <VoteButtons {entry} />
      </div>
      <p class="mt-1.5 flex items-center gap-2 text-xs text-ink-400">
        <Icon name="lucide:clock" class="size-3.5" aria-hidden="true" />
        Votes updated {timeAgo(entry.updatedAt)}
        <span class="hidden sm:inline">· see full discussion for every position</span>
      </p>
    </div>
  </div>

  <p class="px-4 pb-4 text-sm leading-6 text-ink-600 sm:px-5 sm:pb-0">{entry.description}</p>

  <div class="px-4 pb-4 sm:px-5">
    <section aria-label={`Top comments about ${entry.name}`} class="mt-4 rounded-lg border border-ink-200 bg-ink-50 p-3 sm:mt-0">
      <p class="nr-label mb-2">Top comments</p>
      {comments.length > 0 ? (
        <ul class="space-y-2">
          {comments.map((c) => <CommentItem comment={c} />)}
        </ul>
      ) : (
        <p class="py-1 text-xs text-ink-500">No comments yet; be the first to weigh in.</p>
      )}
      <p class="mt-3 flex items-center justify-between gap-3">
        <a href={url(discussion + "?respond=1")} class="nr-btn-outline inline-flex px-3 py-1.5 text-xs">
          <Icon name="lucide:message-square-plus" class="size-3.5" aria-hidden="true" />
          Add comment
        </a>
        <a href={url(discussion)} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:underline">
          Read more comments
          <span class="text-ink-400">({total})</span>
          <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </p>
    </section>
  </div>
</li>
