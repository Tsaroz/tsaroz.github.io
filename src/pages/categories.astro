---
import BaseLayout from "@layouts/BaseLayout.astro";
import { IS_LIVE } from "@lib/config";
import SectionHeading from "@components/SectionHeading.astro";
import CategoryCard from "@components/CategoryCard.astro";
import { getCategories, categoryStats } from "@data";

const cats = getCategories();
const totals = cats.reduce(
  (acc, c) => {
    const s = categoryStats(c.slug);
    acc.rankings += s.rankings;
    acc.entries += s.entries;
    return acc;
  },
  { rankings: 0, entries: 0 },
);
---

<BaseLayout
  title="All Categories | NepalRanks"
  description={`Browse every NepalRanks category: ${cats.map((c) => c.name).join(", ")}, ${totals.rankings} community-voted rankings and ${totals.entries} ranked entries.${IS_LIVE ? " Voted live." : " Design preview with sample data."}`}
>
  <div class="nr-container pt-8">
    <SectionHeading
      title="All categories"
      icon="lucide:layout-grid"
      sub={`${cats.length} categories · ${totals.rankings} rankings · ${totals.entries} ranked entries, ${IS_LIVE ? "decided by community votes" : "all with fictional sample data"}.`}
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cats.map((c) => <CategoryCard category={c} />)}
    </div>
  </div>
</BaseLayout>
