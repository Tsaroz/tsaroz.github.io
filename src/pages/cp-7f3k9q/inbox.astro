---
import AdminLayout from "@layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
---

<AdminLayout title="Messages" heading="Contact inbox" sub="Every message the contact form receives. Answer by replying to the sender's email from your own mailbox; mark them here.">
  <div class="nr-card overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-100 px-5 py-4">
      <h2 class="flex items-center gap-2 font-display text-base font-bold">
        <Icon name="lucide:inbox" class="size-4.5 text-brand-600" aria-hidden="true" />
        Messages
        <span data-count class="nr-badge bg-ink-100 tabular-nums text-ink-600">…</span>
      </h2>
      <select data-filter class="rounded-lg border border-ink-200 bg-white px-3 py-1.5 text-sm">
        <option value="new">new</option>
        <option value="answered">answered</option>
        <option value="spam">spam</option>
        <option value="all">all</option>
      </select>
    </div>
    <ul class="divide-y divide-ink-100" data-list></ul>
    <p data-empty class="hidden border-t border-ink-100 bg-ink-50 px-5 py-4 text-sm text-ink-500">Inbox zero.</p>
  </div>

  <script>
    import { list, rpc, adminGuard } from "@lib/adminclient";
    import { adminToast } from "@lib/admin";

    type Msg = { id: string; name: string; topic: string; body: string; status: string; sender_email: string; user_id: string; created_at: string };
    const esc = (s: string) => s.replace(/[&><"']/g, (ch) => ({ "&": "&amp;", ">": "&gt;", "<": "&lt;", '"': "&quot;", "'": "&#39;" })[ch]!);
    const TOPICS: Record<string, string> = { general: "General", ranking: "Ranking fix", report: "Report", deletion: "Data deletion", partnership: "Partnership", press: "Press" };

    if (!adminGuard()) throw new Error("guard");
    const listEl = document.querySelector<HTMLElement>("[data-list]")!;
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const count = document.querySelector<HTMLElement>("[data-count]")!;
    const filter = document.querySelector<HTMLSelectElement>("[data-filter]")!;

    async function load() {
      try {
        const q = filter.value === "all" ? "?select=*&order=created_at.desc&limit=200" : `?select=*&status=eq.${filter.value}&order=created_at.desc&limit=200`;
        const rows = await list<Msg>("contact_inbox", q);
        count.textContent = String(rows.length);
        empty.classList.toggle("hidden", rows.length > 0);
        listEl.innerHTML = rows
          .map(
            (m) =>
              `<li class="p-5" data-id="${m.id}"><div class="flex flex-wrap items-start justify-between gap-3">` +
              `<div class="min-w-0"><p class="text-sm"><strong class="font-semibold">${esc(m.name || "unnamed")}</strong>` +
              `<span class="text-ink-400"> · </span><a class="nr-link" href="mailto:${esc(m.sender_email)}">${esc(m.sender_email)}</a>` +
              `<span class="nr-badge ml-2 bg-brand-50 text-brand-700">${esc(TOPICS[m.topic] ?? m.topic)}</span></p>` +
              `<p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-ink-700">${esc(m.body)}</p>` +
              `<p class="mt-2 text-xs text-ink-400">${new Date(m.created_at).toLocaleString("en-GB")} · ${m.status}</p></div>` +
              `<div class="flex shrink-0 gap-1.5">` +
              (m.status !== "answered" ? `<button type="button" data-act="answered" class="rounded-md bg-up-600 px-3 py-1.5 text-xs font-semibold text-white">Answered</button>` : "") +
              (m.status !== "spam" ? `<button type="button" data-act="spam" class="rounded-md border border-ink-200 px-3 py-1.5 text-xs font-semibold text-ink-600 hover:border-down-500 hover:text-down-700">Spam</button>` : "") +
              `<button type="button" data-del class="rounded-md border border-ink-200 px-3 py-1.5 text-xs font-semibold text-ink-600 hover:border-down-500 hover:text-down-700">Delete</button></div></div></li>`,
          )
          .join("");
      } catch (err) {
        adminToast(`Inbox: ${String(err)} (staff sign-in required)`, false);
      }
    }

    listEl.addEventListener("click", async (e) => {
      const li = (e.target as HTMLElement).closest("[data-id]");
      if (!li) return;
      const act = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-act]");
      const del = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-del]");
      const id = li.getAttribute("data-id")!;
      try {
        if (act) { await rpc("mark_contact", { p_id: id, p_status: act.dataset.act }); adminToast("Updated."); }
        else if (del) { await rpc("delete_contact", { p_id: id }); adminToast("Deleted."); }
        else return;
        load();
      } catch (err) { adminToast(String(err), false); }
    });
    filter.addEventListener("change", load);
    load();
  </script>
</AdminLayout>
