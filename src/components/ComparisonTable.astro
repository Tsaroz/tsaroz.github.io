---
import { Icon } from "astro-icon/components";

interface Product {
  name: string;
  brand?: string;
  price?: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  specs?: Record<string, string>;
}

interface Column {
  key: string;
  label: string;
}

interface Props {
  products: Product[];
  columns: Column[];
  anchorFor?: (index: number) => string;
}

const { products, columns } = Astro.props;
const anchorFor = Astro.props.anchorFor ?? ((i: number) => `pick-${i + 1}`);

const cell = (p: Product, key: string) => {
  if (key === "price") return p.price ?? p.specs?.price ?? "—";
  return p.specs?.[key] ?? "—";
};
---

<div class="nr-panel-flat my-8 overflow-hidden">
  <div class="flex items-center gap-2 border-b-2 px-4 py-3" style="border-color: var(--nr-border); background: var(--nr-bg-sunken);">
    <Icon name="lucide:table-2" class="size-4" style="color: var(--nr-accent);" aria-hidden="true" />
    <p class="font-mono text-[11px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-muted);">
      Side-by-side comparison
    </p>
  </div>

  <!-- Mobile: stacked cards (no horizontal scrolling) -->
  <ul class="divide-y-2 sm:hidden" style="border-color: var(--nr-border-soft);">
    {products.map((p, i) => (
      <li class="p-4">
        <a href={`#${anchorFor(i)}`} class="group flex items-center gap-3">
          {p.image ? (
            <img
              src={p.image}
              alt={p.imageAlt ?? ""}
              loading="lazy"
              class="size-12 shrink-0 rounded-md border-2 object-contain"
              style="border-color: var(--nr-border); background: var(--nr-bg-raised);"
            />
          ) : (
            <span
              class="grid size-12 shrink-0 place-items-center rounded-md border-2"
              style="border-color: var(--nr-border); background: var(--nr-bg-raised); color: var(--nr-text-soft);"
            >
              <Icon name="lucide:package" class="size-5" aria-hidden="true" />
            </span>
          )}
          <span class="flex min-w-0 flex-col">
            <span class="font-display text-sm font-bold leading-tight group-hover:underline">
              {p.name}
            </span>
            <span class="mt-1 flex flex-wrap items-center gap-1.5">
              {p.badge && (
                <span class="w-fit rounded-full px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wide" style="background: var(--nr-crimson); color: #fff;">
                  {p.badge}
                </span>
              )}
              {p.price && (
                <span class="font-display text-sm font-bold" style="color: var(--nr-accent);">{p.price}</span>
              )}
            </span>
          </span>
        </a>

        <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
          {columns.filter((c) => c.key !== "price").map((c) => (
            <div class="flex flex-col">
              <dt class="font-mono text-[9px] font-bold uppercase tracking-[0.12em]" style="color: var(--nr-text-soft);">
                {c.label}
              </dt>
              <dd class="text-sm font-semibold" style="color: var(--nr-text);">{cell(p, c.key)}</dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ul>

  <!-- Desktop / tablet: full table -->
  <div class="hidden overflow-x-auto sm:block">
    <table class="w-full min-w-[44rem] border-collapse text-sm">
      <thead>
        <tr style="background: var(--nr-accent); color: var(--nr-accent-ink);">
          <th
            scope="col"
            class="sticky left-0 z-10 px-4 py-3 text-left font-display text-sm font-bold"
            style="background: var(--nr-accent); color: var(--nr-accent-ink);"
          >
            Model
          </th>
          {columns.map((c) => (
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-left font-semibold">
              {c.label}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {products.map((p, i) => (
          <tr style={i % 2 ? "background: var(--nr-bg-sunken);" : ""}>
            <th
              scope="row"
              class="sticky left-0 z-10 border-t-2 px-4 py-3 text-left align-middle"
              style={`border-color: var(--nr-border-soft); background: ${i % 2 ? "var(--nr-bg-sunken)" : "var(--nr-bg-raised)"};`}
            >
              <a href={`#${anchorFor(i)}`} class="group flex items-center gap-2.5">
                {p.image ? (
                  <img
                    src={p.image}
                    alt={p.imageAlt ?? ""}
                    loading="lazy"
                    class="size-10 shrink-0 rounded-md border-2 object-contain"
                    style="border-color: var(--nr-border); background: var(--nr-bg-raised);"
                  />
                ) : (
                  <span
                    class="grid size-10 shrink-0 place-items-center rounded-md border-2"
                    style="border-color: var(--nr-border); background: var(--nr-bg-raised); color: var(--nr-text-soft);"
                  >
                    <Icon name="lucide:package" class="size-5" aria-hidden="true" />
                  </span>
                )}
                <span class="flex flex-col">
                  <span class="font-display text-sm font-bold leading-tight group-hover:underline">
                    {p.name}
                  </span>
                  {p.badge && (
                    <span class="mt-1 w-fit rounded-full px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wide" style="background: var(--nr-crimson); color: #fff;">
                      {p.badge}
                    </span>
                  )}
                </span>
              </a>
            </th>
            {columns.map((c) => (
              <td
                class="whitespace-nowrap border-t-2 px-4 py-3 align-middle"
                style="border-color: var(--nr-border-soft);"
              >
                {c.key === "price" ? (
                  <span class="font-display font-bold" style="color: var(--nr-accent);">{cell(p, c.key)}</span>
                ) : (
                  <span style="color: var(--nr-text-muted);">{cell(p, c.key)}</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
