---
import BaseLayout from "./BaseLayout.astro";
import AdminToolbar from "@components/AdminToolbar.astro";
import { Icon } from "astro-icon/components";
import { url } from "@utils/url";
import { CP } from "@lib/config";
const SITE = "https://nepalranks.com";
const cp = CP;

interface Props {
  title: string;
  heading: string;
  sub?: string;
}

const { title, heading, sub } = Astro.props;
const nav = [
  { href: cp + "/", icon: "lucide:layout-dashboard", label: "Dashboard" },
  { href: cp + "/categories/", icon: "lucide:tags", label: "Categories" },
  { href: cp + "/rankings/", icon: "lucide:list-ordered", label: "Rankings" },
  { href: cp + "/entries/", icon: "lucide:bookmark", label: "Entries" },
  { href: cp + "/inbox/", icon: "lucide:inbox", label: "Messages" },
  { href: cp + "/comments/", icon: "lucide:messages-square", label: "Comment moderation" },
  { href: cp + "/users/", icon: "lucide:users", label: "Users" },
  { href: cp + "/cities/", icon: "lucide:map", label: "Cities" },
  { href: cp + "/settings/", icon: "lucide:settings", label: "Site settings" },
];
const current = Astro.url.pathname.replace(/\/+$/, "") || CP;
const cpBase = url(cp).replace(/\/+$/, "");
const isActive = (href: string) => {
  const h = url(href).replace(/\/+$/, "");
  return current === h || (h !== cpBase && h !== "" && current.startsWith(h + "/"));
};
---

<BaseLayout title={`${title} | NepalRanks Admin`} description="NepalRanks staff console." noindex hideHeader hideFooter>
  <div class="flex min-h-screen flex-col bg-ink-50 lg:flex-row">

    <aside class="bg-ink-950 text-ink-300 lg:min-h-screen lg:w-64 lg:shrink-0">
      <div class="flex items-center justify-between p-4 lg:block">
        <a href={url("/admin/")} class="flex items-center gap-2.5">
          <span class="grid size-9 place-items-center rounded-lg bg-white/10">
            <Icon name="lucide:chart-column" class="size-5 text-brand-300" aria-hidden="true" />
          </span>
          <span>
            <span class="block font-display text-base font-bold text-white">NepalRanks</span>
            <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500">Admin</span>
          </span>
        </a>
        <details class="lg:hidden">
          <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-lg border border-white/15 text-white [&::-webkit-details-marker]:hidden">
            <Icon name="lucide:menu" class="size-5" aria-hidden="true" /><span class="sr-only">Admin navigation</span>
          </summary>
          <nav class="absolute right-4 z-40 mt-2 w-56 rounded-xl border border-ink-200 bg-white p-2 shadow-card" aria-label="Admin">
            {nav.map((n) => (
              <a href={url(n.href)} class:list={["block rounded-lg px-3 py-2 text-sm font-medium", isActive(n.href) ? "bg-brand-50 text-brand-700" : "text-ink-700 hover:bg-ink-100"]}>{n.label}</a>
            ))}
            <a href={SITE} class="mt-1 block rounded-lg px-3 py-2 text-sm font-medium text-ink-500 hover:bg-ink-100">← Public site</a>
          </nav>
        </details>
      </div>

      <nav class="hidden pb-6 lg:block" aria-label="Admin sections">
        <ul class="space-y-0.5 px-3 py-4">
          {nav.map((n) => (
            <li>
              <a
                href={url(n.href)}
                aria-current={isActive(n.href) ? "page" : undefined}
                class:list={[
                  "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                  isActive(n.href)
                    ? "bg-brand-600 text-white"
                    : "text-ink-400 hover:bg-white/5 hover:text-white",
                ]}
              >
                <Icon name={n.icon} class="size-4.5" aria-hidden="true" />
                {n.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mx-3 border-t border-white/10 pt-4">
          <a href={SITE} class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-ink-400 hover:bg-white/5 hover:text-white">
            <Icon name="lucide:external-link" class="size-4.5" aria-hidden="true" />
            View public site
          </a>
        </div>
      </nav>
    </aside>

    <div class="min-w-0 flex-1">
      <AdminToolbar />
      <header class="border-b border-ink-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h1 class="font-display text-2xl font-bold tracking-tight">{heading}</h1>
              {sub && <p class="mt-1 text-sm text-ink-500">{sub}</p>}
            </div>
            {import.meta.env.DEV ? (
              <span class="nr-badge bg-up-100 text-up-700 ring-1 ring-up-500/30">
                <Icon name="lucide:pencil-ruler" class="size-3.5" aria-hidden="true" />
                Local panel, writes enabled
              </span>
            ) : (
              <span class="nr-badge bg-brand-50 text-brand-700 ring-1 ring-brand-500/30">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
                Live · saves apply immediately
              </span>
            )}
          </div>
          <p class="mt-3 flex items-center gap-2 rounded-lg bg-ink-100 px-3 py-2 text-xs text-ink-600">
            <Icon name="lucide:info" class="size-4 shrink-0 text-ink-400" aria-hidden="true" />
            Edits save immediately. Public pages refresh automatically.
          </p>
        </div>
      </header>

      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <slot />
      </div>

      <footer class="mx-auto max-w-6xl px-4 pb-8 text-xs text-ink-400 sm:px-6">
        NepalRanks Admin · <a class="nr-link" href={SITE}>exit to public site</a>
      </footer>
    </div>
  </div>
</BaseLayout>
