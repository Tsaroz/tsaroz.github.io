---
import AdminLayout from "@layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
import { getCategories, categoryStats } from "@data";
import { url } from "@utils/url";
const jsonCats = getCategories();
---

<AdminLayout title="Categories" heading="Category management" sub="Saves apply immediately; public pages update automatically.">
  <section class="nr-card mb-6 p-5">
    <h2 class="font-display text-base font-bold">Add a category</h2>
    <form data-add class="mt-4 grid gap-3 sm:grid-cols-4">
      <input name="name" required placeholder="Name" class="rounded-lg border border-ink-200 px-3 py-2 text-sm" />
      <input name="icon" placeholder="lucide:landmark" class="rounded-lg border border-ink-200 px-3 py-2 font-mono text-sm" />
      <input name="description" placeholder="Description" class="rounded-lg border border-ink-200 px-3 py-2 text-sm sm:col-span-2" />
      <div class="sm:col-span-4"><button type="submit" class="nr-btn-primary">Create</button></div>
    </form>
  </section>

  <div class="nr-card overflow-hidden">
    <table class="nr-cards w-full text-left text-sm">
      <thead>
        <tr class="border-b border-ink-100 bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
          <th class="px-5 py-3 font-semibold">Category</th>
          <th class="px-5 py-3 text-right font-semibold">Rankings</th>
          <th class="px-5 py-3 text-right font-semibold">Entries</th>
          <th class="px-5 py-3 font-semibold">Edit</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-100" data-body>
        {jsonCats.map((c) => (
          <tr data-row={c.id}>
            <td class="px-5 py-4" data-label="Category"><span class="flex items-center gap-2.5"><Icon name={c.icon} class="size-4 text-brand-600" aria-hidden="true" /><a class="font-semibold hover:text-brand-700" href={url(`/category/${c.slug}/`)}>{c.name}</a><span class="font-mono text-[11px] text-ink-400">{c.slug}</span></span></td>
            <td class="px-5 py-4 text-right tabular-nums" data-label="Rankings">{categoryStats(c.slug).rankings}</td>
            <td class="px-5 py-4 text-right tabular-nums" data-label="Entries">{categoryStats(c.slug).entries}</td>
            <td class="px-5 py-4" data-label="Edit"><span class="flex flex-wrap items-center gap-1.5">
              <input data-f="name" value={c.name} class="w-28 rounded-md border border-ink-200 px-2 py-1 text-xs" />
              <input data-f="icon" value={c.icon} class="w-32 rounded-md border border-ink-200 px-2 py-1 font-mono text-xs" />
              <input data-f="description" value={c.description} class="w-40 rounded-md border border-ink-200 px-2 py-1 text-xs" />
              <button type="button" data-save class="rounded-md bg-brand-600 px-2.5 py-1 text-xs font-semibold text-white">Save</button>
            </span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    import { insert, update, nowIso, slugify, adminGuard } from "@lib/adminclient";
    import { adminToast } from "@lib/admin";
    const go = adminGuard();
    if (go) {
      document.querySelector<HTMLFormElement>("[data-add]")!.addEventListener("submit", async (e) => {
        e.preventDefault();
        const f = Object.fromEntries(new FormData(e.target as HTMLFormElement));
        const id = `c-${slugify(String(f.name))}`;
        try {
          await insert("cat_categories", { id, name: f.name, slug: slugify(String(f.name)), description: f.description ?? "", icon: f.icon || "lucide:star", created_at: nowIso(), updated_at: nowIso() });
          adminToast("Category created, reload to see stats.");
          (e.target as HTMLFormElement).reset();
        } catch (err) { adminToast(String(err), false); }
      });
      document.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
        row.querySelector("[data-save]")!.addEventListener("click", async () => {
          const patch: Record<string, string> = { updated_at: nowIso() };
          row.querySelectorAll<HTMLInputElement>("[data-f]").forEach((i) => (patch[i.dataset.f!] = i.value));
          try { await update("cat_categories", `id=eq.${row.dataset.row}`, patch); adminToast("Saved."); }
          catch (err) { adminToast(String(err), false); }
        });
      });
    }
  </script>
</AdminLayout>
