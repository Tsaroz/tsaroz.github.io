---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductCard from "@components/ProductCard.astro";
import ComparisonTable from "@components/ComparisonTable.astro";
import Toc from "@components/Toc.astro";
import FaqSection from "@components/FaqSection.astro";
import { url } from "@utils/url";
import { formatDate, readingTime, slugOf, type Article } from "@lib/articles";
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
  buildItemListJsonLd,
  buildFaqJsonLd,
  analyzeSeo,
  type SiteContext,
} from "@lib/seo";

interface Props {
  entry: Article;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const d = entry.data;
const body = entry.body ?? "";
const site = Astro.site ?? new URL("https://nepalranks.com");
const isComparison = d.articleType !== "info" && d.products.length > 0;

const seoInput = {
  ...d,
  slug: slugOf(entry),
  body,
};
const ctx: SiteContext = {
  origin: site.origin,
  siteName: "NepalRanks",
  logo: "favicon.svg",
};

const articleLd = buildArticleJsonLd(seoInput, ctx);
const breadcrumbLd = buildBreadcrumbJsonLd(seoInput, ctx);
const itemListLd = buildItemListJsonLd(seoInput);
const faqLd = buildFaqJsonLd(d.faqs ?? []);
const seo = import.meta.env.DEV ? analyzeSeo(seoInput) : null;

const typeLabel = isComparison ? "Ranking" : "Guide";
---

<BaseLayout
  title={`${d.title} | NepalRanks`}
  description={d.description}
  ogImage={d.coverImage}
  ogType="article"
  noindex={d.noindex}
  publishedTime={d.publishedAt.toISOString()}
  modifiedTime={(d.updatedAt ?? d.publishedAt).toISOString()}
  articleAuthor={d.author}
  articleSection={d.category}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />
  {itemListLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListLd)} />}
  {faqLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />}
  {d.keywords.length > 0 && <meta name="keywords" content={d.keywords.join(", ")} slot="head" />}
  <meta name="robots" content={d.noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} slot="head" />

  <div class="mx-auto w-full max-w-7xl px-4 pb-16 pt-6 sm:px-6">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="font-mono text-[11px] uppercase tracking-wide" style="color: var(--nr-text-soft);">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={url("/")} class="hover:underline" style="color: var(--nr-text-muted);">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={url("/articles/")} class="hover:underline" style="color: var(--nr-text-muted);">Articles</a></li>
        <li aria-hidden="true">/</li>
        <li class="truncate" style="color: var(--nr-text);" aria-current="page">{d.title}</li>
      </ol>
    </nav>

    <!-- Article header -->
    <header class="mt-6 max-w-4xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class="nr-badge" style="background: var(--nr-accent); color: var(--nr-accent-ink);">
          {d.category}
        </span>
        <span class="nr-badge" style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);">
          <Icon name={isComparison ? "lucide:git-compare" : "lucide:book-open"} class="size-3" aria-hidden="true" />
          {typeLabel}
        </span>
      </div>
      <h1 class="mt-4 font-display text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl lg:text-[2.75rem]">
        {d.title}
      </h1>
      <p class="mt-4 text-lg leading-8" style="color: var(--nr-text-muted);">{d.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-[11px] uppercase tracking-wide" style="color: var(--nr-text-soft);">
        <span class="inline-flex items-center gap-1.5"><Icon name="lucide:pen-line" class="size-3.5" />{d.author}</span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:calendar" class="size-3.5" />
          <time datetime={d.publishedAt.toISOString()}>{formatDate(d.updatedAt ?? d.publishedAt)}</time>
        </span>
        <span class="inline-flex items-center gap-1.5"><Icon name="lucide:clock" class="size-3.5" />{readingTime(body)} min read</span>
      </div>
    </header>

    {d.coverImage && (
      <figure class="mt-8">
        <img
          src={d.coverImage}
          alt={d.coverImageAlt ?? d.title}
          class="aspect-[16/8] w-full rounded-2xl border-2 object-cover"
          style="border-color: var(--nr-border); box-shadow: var(--shadow-pop);"
          fetchpriority="high"
        />
      </figure>
    )}

    {isComparison ? (
      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="min-w-0">
          {d.intro && (
            <div
              class="rounded-2xl border-2 p-5 text-lg leading-8 sm:p-6"
              style="border-color: var(--nr-border); background: var(--nr-bg-raised); box-shadow: var(--shadow-pop-sm);"
            >
              <p style="color: var(--nr-text);">{d.intro}</p>
            </div>
          )}

          {d.comparisonColumns.length > 0 && (
            <section class="mt-10" aria-labelledby="compare-h">
              <h2 id="compare-h" class="scroll-mt-24 font-display text-2xl font-bold sm:text-3xl">
                Comparison table
              </h2>
              <ComparisonTable products={d.products} columns={d.comparisonColumns} />
            </section>
          )}

          {d.products.length > 0 && (
            <section class="mt-12" aria-labelledby="products-h">
              <h2 id="products-h" class="scroll-mt-24 font-display text-2xl font-bold sm:text-3xl">
                The picks, reviewed
              </h2>
              <div class="mt-6 space-y-6">
                {d.products.map((p, i) => (
                  <ProductCard {...p} rank={i + 1} anchor={`pick-${i + 1}`} />
                ))}
              </div>
            </section>
          )}

          <div class="nr-article mt-12">
            <slot />
          </div>

          {d.conclusion && (
            <section class="mt-12" aria-labelledby="conclusion-h">
              <h2 id="conclusion-h" class="scroll-mt-24 font-display text-2xl font-bold sm:text-3xl">Conclusion</h2>
              <div
                class="mt-4 rounded-xl border-2 border-l-[10px] p-5 text-[1.0625rem] leading-8"
                style="border-color: var(--nr-border); border-left-color: var(--nr-gold); background: var(--nr-bg-sunken); box-shadow: var(--shadow-pop-sm);"
              >
                <p style="color: var(--nr-text);">{d.conclusion}</p>
              </div>
            </section>
          )}

          {(d.faqs ?? []).length > 0 && <FaqSection faqs={d.faqs} />}
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-20 space-y-4">
            <Toc headings={headings} />
            <div class="nr-panel-flat p-4">
              <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">Quick jump</p>
              <ul class="mt-2 space-y-1 text-[13px]">
                {d.products.map((p, i) => (
                  <li>
                    <a href={`#pick-${i + 1}`} class="flex items-center gap-2 py-0.5 hover:underline" style="color: var(--nr-text-muted);">
                      <span class="grid size-5 shrink-0 place-items-center rounded font-mono text-[10px] font-bold" style="background: var(--nr-accent); color: var(--nr-accent-ink);">{i + 1}</span>
                      <span class="truncate">{p.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    ) : (
      <div class="mt-10 grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
        <aside class="order-2 lg:order-1">
          <div class="lg:sticky lg:top-20 space-y-4">
            <Toc headings={headings} />
            <div class="nr-panel-flat p-4">
              <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em]" style="color: var(--nr-text-soft);">In this guide</p>
              <p class="mt-2 text-[13px] leading-6" style="color: var(--nr-text-muted);">
                A plain-English explainer. Jump to any section using the contents above.
              </p>
            </div>
          </div>
        </aside>

        <div class="order-1 min-w-0 lg:order-2">
          {d.intro && (
            <p class="mb-6 text-lg leading-8 first-letter:float-left first-letter:mr-2 first-letter:font-display first-letter:text-6xl first-letter:font-bold first-letter:leading-[0.8]" style="color: var(--nr-text);">
              {d.intro}
            </p>
          )}

          <div class="nr-article">
            <slot />
          </div>

          {d.conclusion && (
            <section class="mt-12" aria-labelledby="conclusion-h">
              <h2 id="conclusion-h" class="scroll-mt-24 font-display text-2xl font-bold sm:text-3xl">The takeaway</h2>
              <div
                class="mt-4 rounded-xl border-2 border-l-[10px] p-5 text-[1.0625rem] leading-8"
                style="border-color: var(--nr-border); border-left-color: var(--nr-gold); background: var(--nr-bg-sunken); box-shadow: var(--shadow-pop-sm);"
              >
                <p style="color: var(--nr-text);">{d.conclusion}</p>
              </div>
            </section>
          )}

          {(d.faqs ?? []).length > 0 && <FaqSection faqs={d.faqs} />}
        </div>
      </div>
    )}

    {seo && (
      <details class="mt-12 rounded-xl border-2 border-dashed p-4 text-sm" style="border-color: var(--nr-gold); background: var(--nr-bg-sunken);">
        <summary class="cursor-pointer font-semibold">
          SEO self-check (dev only) — score {seo.score}/100
        </summary>
        <ul class="mt-3 space-y-1">
          {seo.issues.map((i) => (
            <li class="flex gap-2">
              <span class="font-mono">{i.level === "ok" ? "✓" : i.level === "warn" ? "!" : "×"}</span>
              <span><strong>{i.label}.</strong> {i.detail}</span>
            </li>
          ))}
        </ul>
        <p class="mt-3" style="color: var(--nr-text-muted);">
          {seo.wordCount} words · {seo.readingTime} min read · title {seo.titleLength}ch · description {seo.descriptionLength}ch
        </p>
      </details>
    )}
  </div>
</BaseLayout>


