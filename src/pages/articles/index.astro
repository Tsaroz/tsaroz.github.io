---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArticleCard from "@components/ArticleCard.astro";
import { Icon } from "astro-icon/components";
import { getArticles } from "@lib/articles";
import { resolveCategories } from "@lib/categories";

const articles = await getArticles();
const categories = resolveCategories(articles.map((a) => a.data.category));
const comparisons = articles.filter((a) => a.data.articleType !== "info" && a.data.products.length > 0);
const guides = articles.filter((a) => !(a.data.articleType !== "info" && a.data.products.length > 0));
---

<BaseLayout
  title="All Rankings & Guides | NepalRanks"
  description="Browse every independent ranking and guide for the best products, restaurants, places and experiences in Nepal."
>
  <div class="mx-auto w-full max-w-7xl px-4 pt-10 sm:px-6">
    <p class="nr-label">The archive</p>
    <h1 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">All articles</h1>
    <p class="mt-3 max-w-2xl" style="color: var(--nr-text-muted);">
      {articles.length} independent guide{articles.length === 1 ? "" : "s"} across {categories.length} categor{categories.length === 1 ? "y" : "ies"}.
    </p>

    {categories.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2" id="category-filters">
        <button
          type="button"
          class="nr-badge category-filter is-active"
          data-slug=""
          style="background: var(--nr-accent); color: var(--nr-accent-ink);"
        >
          All
        </button>
        {categories.map((c) => (
          <button
            type="button"
            class="nr-badge category-filter"
            data-slug={c.slug}
            data-name={c.name}
            style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);"
          >
            {c.name}
          </button>
        ))}
      </div>
    )}
  </div>

  {comparisons.length > 0 && (
    <section class="mx-auto w-full max-w-7xl px-4 pt-12 sm:px-6" aria-labelledby="cmp-h">
      <div class="mb-6 flex items-center gap-2 border-b-2 pb-3" style="border-color: var(--nr-border);">
        <Icon name="lucide:git-compare" class="size-5" style="color: var(--nr-accent);" aria-hidden="true" />
        <h2 id="cmp-h" class="font-display text-2xl font-bold">Best-of rankings</h2>
        <span class="nr-badge ml-auto" style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);">{comparisons.length}</span>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {comparisons.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="mx-auto w-full max-w-7xl px-4 pt-14 sm:px-6" aria-labelledby="info-h">
      <div class="mb-6 flex items-center gap-2 border-b-2 pb-3" style="border-color: var(--nr-border);">
        <Icon name="lucide:book-open" class="size-5" style="color: var(--nr-gold);" aria-hidden="true" />
        <h2 id="info-h" class="font-display text-2xl font-bold">Guides & explainers</h2>
        <span class="nr-badge ml-auto" style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);">{guides.length}</span>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  {articles.length === 0 && (
    <section class="mx-auto w-full max-w-7xl px-4 py-16 text-center sm:px-6">
      <p style="color: var(--nr-text-muted);">No articles yet. Add one from the admin panel.</p>
    </section>
  )}

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".category-filter"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("section[aria-labelledby]"));

    const apply = (slug: string) => {
      filters.forEach((b) => {
        const active = b.dataset.slug === slug;
        b.classList.toggle("is-active", active);
        b.style.background = active ? "var(--nr-accent)" : "var(--nr-bg-sunken)";
        b.style.color = active ? "var(--nr-accent-ink)" : "var(--nr-text-muted)";
      });
      const name = filters.find((b) => b.dataset.slug === slug)?.dataset.name ?? "";
      cards.forEach((card) => {
        card.style.display = !slug || card.dataset.category === name ? "" : "none";
      });
      sections.forEach((s) => {
        const visible = Array.from(s.querySelectorAll<HTMLElement>("[data-category]")).some(
          (c) => c.style.display !== "none",
        );
        s.style.display = visible ? "" : "none";
      });
      const params = new URLSearchParams(location.search);
      if (slug) params.set("category", slug);
      else params.delete("category");
      const qs = params.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    };

    filters.forEach((b) => b.addEventListener("click", () => apply(b.dataset.slug ?? "")));

    const initial = new URLSearchParams(location.search).get("category");
    if (initial && filters.some((b) => b.dataset.slug === initial)) apply(initial);
  </script>
</BaseLayout>
