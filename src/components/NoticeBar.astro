---

import { Icon } from "astro-icon/components";
import { getSettings } from "@data";
import type { NoticeScope } from "@data/types";

interface Props {
  scope: NoticeScope;
}

const { scope } = Astro.props;
const msg = (getSettings().notices ?? {})[scope]?.trim();
---

{msg && (
  <div class="nr-container pt-6">
    <aside class="nr-card flex items-start gap-3 border-brand-200 bg-brand-50 p-4 text-sm" role="note">
      <Icon name="lucide:megaphone" class="mt-0.5 size-5 shrink-0 text-brand-600" aria-hidden="true" />
      <div class="nr-prose min-w-0 flex-1 text-ink-700" set:html={msg} />
    </aside>
  </div>
)}
