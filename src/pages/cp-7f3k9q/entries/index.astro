---
import AdminLayout from "@layouts/AdminLayout.astro";
import { Icon } from "astro-icon/components";
import { allDecorated } from "@data";
import { url, formatNumber } from "@utils/url";
import { CP } from "@lib/config";

const ranks = allDecorated().sort((a, b) => a.title.localeCompare(b.title));
const totalEntries = ranks.reduce((s, r) => s + r.entryCount, 0);
---

<AdminLayout title="Entries" heading="Entry management" sub={`${ranks.length} rankings · ${totalEntries} entries. Pick a ranking to add or edit its entries.`}>
  <div class="nr-card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="nr-cards w-full text-left text-sm">
        <thead>
          <tr class="border-b border-ink-100 bg-ink-50 text-xs uppercase tracking-wide text-ink-500">
            <th class="px-5 py-3 font-semibold">Ranking</th>
            <th class="px-5 py-3 font-semibold">Category</th>
            <th class="px-5 py-3 text-right font-semibold">Entries</th>
            <th class="px-5 py-3 text-right font-semibold">Votes</th>
            <th class="px-5 py-3 text-right font-semibold">Manage</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          {ranks.map((r) => (
            <tr class="hover:bg-ink-50/60">
              <td class="px-5 py-3" data-label="Ranking">
                <a href={url(`${CP}/entries/${r.slug}/`)} class="font-semibold text-ink-900 hover:text-brand-700">{r.title}</a>
                <span class="block font-mono text-[11px] text-ink-400">{r.slug}</span>
              </td>
              <td class="px-5 py-3 text-ink-600" data-label="Category">{r.category?.name ?? "—"}</td>
              <td class="px-5 py-3 text-right tabular-nums" data-label="Entries">{r.entryCount}</td>
              <td class="px-5 py-3 text-right tabular-nums" data-label="Votes">{formatNumber(r.totalVotes)}</td>
              <td class="px-5 py-3 text-right" data-label="Manage">
                <a href={url(`${CP}/entries/${r.slug}/`)} class="inline-flex items-center gap-1.5 rounded-md border border-ink-200 px-3 py-1.5 text-xs font-semibold text-ink-600 hover:border-brand-400 hover:text-brand-700">
                  <Icon name="lucide:bookmark" class="size-3.5" aria-hidden="true" />
                  {r.entryCount === 0 ? "Add entries" : `Edit ${r.entryCount} entries`}
                  <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
