---

import { Icon } from "astro-icon/components";
---

<button
  type="button"
  id="nr-prefs-fab"
  class="fixed bottom-5 right-5 z-50 grid size-11 place-items-center rounded-full border border-ink-200 bg-white text-ink-600 shadow-card-hover transition-transform hover:scale-105"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="nr-prefs-panel"
  title="Display settings"
>
  <Icon name="lucide:settings-2" class="size-5" aria-hidden="true" />
  <span class="sr-only">Open display settings</span>
</button>

<div
  id="nr-prefs-panel"
  role="dialog"
  aria-label="Display settings"
  class="fixed bottom-20 right-5 z-50 hidden w-72 rounded-xl border border-ink-200 bg-white p-4 shadow-card-hover"
>
  <p class="nr-label">Appearance</p>
  <div class="mt-2 grid grid-cols-3 gap-1.5" role="radiogroup" aria-label="Theme">
    <button type="button" data-theme-choice="light" class="nr-prefs-choice rounded-lg border border-ink-200 px-2 py-1.5 text-xs font-semibold hover:border-brand-400">
      <Icon name="lucide:sun" class="mx-auto mb-0.5 size-4" aria-hidden="true" />Light
    </button>
    <button type="button" data-theme-choice="dark" class="nr-prefs-choice rounded-lg border border-ink-200 px-2 py-1.5 text-xs font-semibold hover:border-brand-400">
      <Icon name="lucide:moon" class="mx-auto mb-0.5 size-4" aria-hidden="true" />Dark
    </button>
    <button type="button" data-theme-choice="auto" class="nr-prefs-choice rounded-lg border border-ink-200 px-2 py-1.5 text-xs font-semibold hover:border-brand-400">
      <Icon name="lucide:monitor" class="mx-auto mb-0.5 size-4" aria-hidden="true" />Auto
    </button>
  </div>

  <p class="nr-label mt-4">Text size</p>
  <div class="mt-2 grid grid-cols-4 gap-1.5" role="radiogroup" aria-label="Text size">
    <button type="button" data-size-choice="sm" class="nr-prefs-choice rounded-lg border border-ink-200 py-1.5 text-xs font-semibold hover:border-brand-400">A</button>
    <button type="button" data-size-choice="md" class="nr-prefs-choice rounded-lg border border-ink-200 py-1.5 text-sm font-semibold hover:border-brand-400">A</button>
    <button type="button" data-size-choice="lg" class="nr-prefs-choice rounded-lg border border-ink-200 py-1.5 text-base font-semibold hover:border-brand-400">A</button>
    <button type="button" data-size-choice="xl" class="nr-prefs-choice rounded-lg border border-ink-200 py-1.5 text-lg font-semibold hover:border-brand-400">A</button>
  </div>

  <label class="nr-label mt-4 block" for="nr-font">Font</label>
  <select id="nr-font" data-font-choice class="mt-2 w-full rounded-lg border border-ink-200 px-3 py-2 text-sm">
    <option value="default">Default (editorial)</option>
    <option value="serif">Serif</option>
    <option value="grotesk">Grotesk</option>
    <option value="mono">Monospace</option>
  </select>

  <button type="button" data-prefs-reset class="mt-4 w-full rounded-lg border border-ink-200 py-1.5 text-xs font-semibold text-ink-600 hover:border-brand-400 hover:text-brand-700">
    Reset to site defaults
  </button>
</div>

<script>
  import { applyPrefs, readPrefs, savePrefs, syncControls, DEFAULTS } from "@lib/prefs";

  const fab = document.getElementById("nr-prefs-fab")!;
  const panel = document.getElementById("nr-prefs-panel")!;

  fab.addEventListener("click", () => {
    const open = panel.classList.toggle("hidden") === false;
    fab.setAttribute("aria-expanded", String(open));
    if (open) syncControls();
  });
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (!panel.contains(t) && !fab.contains(t) && !panel.classList.contains("hidden")) {
      panel.classList.add("hidden");
      fab.setAttribute("aria-expanded", "false");
    }
  });

  panel.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((btn) =>
    btn.addEventListener("click", () => { savePrefs({ theme: btn.dataset.themeChoice as "light" | "dark" | "auto" }); applyPrefs(); syncControls(); }));
  panel.querySelectorAll<HTMLButtonElement>("[data-size-choice]").forEach((btn) =>
    btn.addEventListener("click", () => { savePrefs({ size: btn.dataset.sizeChoice as "sm" | "md" | "lg" | "xl" }); applyPrefs(); syncControls(); }));
  const fontSel = panel.querySelector<HTMLSelectElement>("[data-font-choice]")!;
  fontSel.addEventListener("change", () => { savePrefs({ font: fontSel.value as "default" | "serif" | "grotesk" | "mono" }); applyPrefs(); syncControls(); });
  panel.querySelector("[data-prefs-reset]")!.addEventListener("click", () => {
    localStorage.removeItem("nr.prefs");
    applyPrefs(DEFAULTS);
    syncControls();
  });
</script>
