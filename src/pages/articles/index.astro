---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArticleCard from "@components/ArticleCard.astro";
import { Icon } from "astro-icon/components";
import { getArticles } from "@lib/articles";

const articles = await getArticles();
const categories = [...new Set(articles.map((a) => a.data.category))];
const comparisons = articles.filter((a) => a.data.articleType !== "info" && a.data.products.length > 0);
const guides = articles.filter((a) => !(a.data.articleType !== "info" && a.data.products.length > 0));
---

<BaseLayout
  title="All Rankings & Guides | NepalRanks"
  description="Browse every independent ranking and guide for the best products, restaurants, places and experiences in Nepal."
>
  <div class="mx-auto w-full max-w-7xl px-4 pt-10 sm:px-6">
    <p class="nr-label">The archive</p>
    <h1 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">All articles</h1>
    <p class="mt-3 max-w-2xl" style="color: var(--nr-text-muted);">
      {articles.length} independent guide{articles.length === 1 ? "" : "s"} across {categories.length} categor{categories.length === 1 ? "y" : "ies"}.
    </p>

    {categories.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {categories.map((c) => (
          <span class="nr-badge" style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);">{c}</span>
        ))}
      </div>
    )}
  </div>

  {comparisons.length > 0 && (
    <section class="mx-auto w-full max-w-7xl px-4 pt-12 sm:px-6" aria-labelledby="cmp-h">
      <div class="mb-6 flex items-center gap-2 border-b-2 pb-3" style="border-color: var(--nr-border);">
        <Icon name="lucide:git-compare" class="size-5" style="color: var(--nr-accent);" aria-hidden="true" />
        <h2 id="cmp-h" class="font-display text-2xl font-bold">Best-of rankings</h2>
        <span class="nr-badge ml-auto" style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);">{comparisons.length}</span>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {comparisons.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="mx-auto w-full max-w-7xl px-4 pt-14 sm:px-6" aria-labelledby="info-h">
      <div class="mb-6 flex items-center gap-2 border-b-2 pb-3" style="border-color: var(--nr-border);">
        <Icon name="lucide:book-open" class="size-5" style="color: var(--nr-gold);" aria-hidden="true" />
        <h2 id="info-h" class="font-display text-2xl font-bold">Guides & explainers</h2>
        <span class="nr-badge ml-auto" style="background: var(--nr-bg-sunken); color: var(--nr-text-muted);">{guides.length}</span>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  {articles.length === 0 && (
    <section class="mx-auto w-full max-w-7xl px-4 py-16 text-center sm:px-6">
      <p style="color: var(--nr-text-muted);">No articles yet. Add one from the admin panel.</p>
    </section>
  )}
</BaseLayout>
